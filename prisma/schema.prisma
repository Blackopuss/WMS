// Database schema. Models are added step by step (PLT-01 onwards).
// Every business table carries organization_id (see AGENTS.md).

generator client {
  provider     = "prisma-client"
  output       = "../src/server/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

// ── Identity (Better Auth core tables, BAS-04) ───────────────────────────
// IDs are UUIDv7 generated by the app (src/lib/ids.ts).

model User {
  id               String         @id @db.Char(36)
  name             String         @db.VarChar(120)
  email            String         @unique @db.VarChar(254)
  emailVerified    Boolean        @default(false)
  /// Set by Better Auth once a TOTP app is verified (PLT-08A).
  twoFactorEnabled Boolean        @default(false)
  image            String?        @db.Text
  createdAt        DateTime       @default(now()) @db.DateTime(3)
  updatedAt        DateTime       @updatedAt @db.DateTime(3)
  sessions         Session[]
  accounts         Account[]
  twoFactor        TwoFactor?
  memberships      Membership[]
  ownedOrgs        Organization[] @relation("OrganizationOwner")
  platformStaff    PlatformStaff?

  @@map("user")
}

model Session {
  id                   String        @id @db.Char(36)
  expiresAt            DateTime      @db.DateTime(3)
  token                String        @unique @db.VarChar(255)
  createdAt            DateTime      @default(now()) @db.DateTime(3)
  updatedAt            DateTime      @updatedAt @db.DateTime(3)
  ipAddress            String?       @db.VarChar(64)
  userAgent            String?       @db.Text
  userId               String        @db.Char(36)
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Company this session works in (PLT-11). Re-checked against an active
  /// membership on every request; never trusted on its own.
  activeOrganizationId String?       @db.Char(36)
  activeOrganization   Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)
  /// Last request seen on this session (WMS-40, ADR 0059), written at most
  /// every few minutes after the response. Null on sessions older than the
  /// column: show updatedAt.
  lastActiveAt         DateTime?     @db.DateTime(3)
  /// Shared terminal this session was opened on with a PIN (WMS-38,
  /// ADR 0061); null for sessions opened with a password. No relation: a
  /// person's row never points to a company table (PLT-13); removing the
  /// terminal deletes its sessions, and terminals are never deleted.
  terminalId           String?       @db.Char(36)
  /// Inactivity that closes a terminal session, copied from the company's
  /// setting when it was opened.
  terminalIdleSeconds  Int?

  @@index([userId])
  @@index([activeOrganizationId])
  @@index([terminalId])
  @@map("session")
}

model Account {
  id                    String    @id @db.Char(36)
  accountId             String    @db.VarChar(255)
  providerId            String    @db.VarChar(64)
  userId                String    @db.Char(36)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime? @db.DateTime(3)
  refreshTokenExpiresAt DateTime? @db.DateTime(3)
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @db.DateTime(3)
  updatedAt             DateTime  @updatedAt @db.DateTime(3)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @db.Char(36)
  identifier String   @db.VarChar(255)
  value      String   @db.Text
  expiresAt  DateTime @db.DateTime(3)
  createdAt  DateTime @default(now()) @db.DateTime(3)
  updatedAt  DateTime @updatedAt @db.DateTime(3)

  @@index([identifier])
  @@map("verification")
}

/// TOTP secret and backup codes (Better Auth two-factor plugin, PLT-08A).
/// Both are encrypted with BETTER_AUTH_SECRET; `verified` stays false until
/// the first code from the app is confirmed.
model TwoFactor {
  id                      String    @id @db.Char(36)
  secret                  String    @db.Text
  backupCodes             String    @db.Text
  userId                  String    @unique @db.Char(36)
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(false)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime? @db.DateTime(3)

  @@map("twoFactor")
}

// ── Tenancy (PLT-01) ──────────────────────────────────────────────────────
// Every business table will reference organization_id. Deletes never
// cascade across tenants: removing data is an explicit, audited process.

model Organization {
  id                           String                        @id @db.Char(36)
  name                         String                        @db.VarChar(120)
  timeZone                     String                        @default("America/Mexico_City") @db.VarChar(64)
  currency                     String                        @default("MXN") @db.Char(3)
  /// Titular: the only account allowed to contract or cancel (USR-03).
  ownerUserId                  String                        @db.Char(36)
  owner                        User                          @relation("OrganizationOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  createdAt                    DateTime                      @default(now()) @db.DateTime(3)
  updatedAt                    DateTime                      @updatedAt @db.DateTime(3)
  memberships                  Membership[]
  memberRoles                  MembershipRole[]
  memberScopes                 MembershipScope[]
  sessions                     Session[]
  auditEvents                  AuditEvent[]
  ownershipTransfers           OwnershipTransfer[]
  invitations                  Invitation[]
  subscriptions                Subscription[]
  subscriptionItems            SubscriptionItem[]
  entitlements                 Entitlement[]
  quotaUsages                  QuotaUsage[]
  products                     Product[]
  productCategories            ProductCategory[]
  productBrands                ProductBrand[]
  productPresentations         ProductPresentation[]
  presentationVersions         PresentationVersion[]
  facilities                   Facility[]
  locationLevels               LocationLevel[]
  locations                    Location[]
  locationCapacities           LocationCapacity[]
  locationRestrictions         LocationRestriction[]
  stockMovements               StockMovement[]
  stockMovementLines           StockMovementLine[]
  stockBalances                StockBalance[]
  stockMinimums                StockMinimum[]
  productCosts                 ProductCost[]
  stockCounts                  StockCount[]
  stockCountLines              StockCountLine[]
  stockCountCaptures           StockCountCapture[]
  jobs                         Job[]
  storedFiles                  StoredFile[]
  storageCleanups              StorageCleanup[]
  productImports               ProductImport[]
  productImportItems           ProductImportItem[]
  exitImports                  ExitImport[]
  outboundImports              OutboundImport[]
  settings                     OrganizationSetting[]
  exitImportRows               ExitImportRow[]
  contacts                     Contact[]
  productSuppliers             ProductSupplier[]
  purchaseOrders               PurchaseOrder[]
  purchaseOrderLines           PurchaseOrderLine[]
  purchaseOrderDeliveries      PurchaseOrderDelivery[]
  purchaseReceipts             PurchaseReceipt[]
  purchaseReceiptLines         PurchaseReceiptLine[]
  purchaseReturns              PurchaseReturn[]
  purchaseReturnLines          PurchaseReturnLine[]
  manualPayments               ManualPayment[]
  checkoutOrders               CheckoutOrder[]
  supportAccesses              SupportAccess[]
  warehouseTasks               WarehouseTask[]
  lots                         Lot[]
  serialUnits                  SerialUnit[]
  serialMoves                  SerialMove[]
  warehouseTaskSerials         WarehouseTaskSerial[]
  stockReservations            StockReservation[]
  stockHolds                   StockHold[]
  stockHoldUnits               StockHoldUnit[]
  outboundOrders               OutboundOrder[]
  outboundOrderLines           OutboundOrderLine[]
  containers                   Container[]
  containerItems               ContainerItem[]
  containerEvents              ContainerEvent[]
  packShortages                OutboundPackShortage[]
  shipments                    Shipment[]
  shipmentOrders               ShipmentOrder[]
  shipmentLines                ShipmentLine[]
  customerReturns              CustomerReturn[]
  customerReturnLines          CustomerReturnLine[]
  customerReturnDecisions      CustomerReturnDecision[]
  facilityTransfers            FacilityTransfer[]
  facilityTransferLines        FacilityTransferLine[]
  facilityTransferReceipts     FacilityTransferReceipt[]
  facilityTransferReceiptLines FacilityTransferReceiptLine[]
  replenishmentRules           ReplenishmentRule[]
  countPrograms                CountProgram[]
  approvalRules                ApprovalRule[]
  approvalRequests             ApprovalRequest[]
  notifications                Notification[]
  notificationPreferences      NotificationPreference[]
  notificationEmails           NotificationEmail[]
  dailyDigests                 DailyDigest[]
  incidents                    Incident[]
  /// API keys and webhook destinations (WMS-60).
  apiKeys                      ApiKey[]
  webhookEndpoints             WebhookEndpoint[]
  webhookEvents                WebhookEvent[]
  webhookDeliveries            WebhookDelivery[]
  incidentNotes                IncidentNote[]
  evidencePhotos               EvidencePhoto[]
  equipmentTypes               EquipmentType[]
  equipment                    Equipment[]
  equipmentMaintenance         EquipmentMaintenance[]
  /// Processes of the company (WMS-74, ADR 0069).
  processDefinitions           ProcessDefinition[]
  processVersions              ProcessVersion[]
  processStages                ProcessStage[]
  processStageRoles            ProcessStageRole[]
  processProgress              ProcessProgress[]
  processStageStates           ProcessStageState[]
  processSteps                 ProcessStep[]
  /// Shared terminals and PINs (WMS-38).
  sharedTerminals              SharedTerminal[]
  sharedTerminalSecrets        SharedTerminalSecret[]
  memberPins                   MemberPin[]
  pickWaves                    PickWave[]
  pickWaveOrders               PickWaveOrder[]
  purchaseRequests             PurchaseRequest[]
  purchaseRequestLines         PurchaseRequestLine[]
  customFields                 CustomField[]
  customFieldOptions           CustomFieldOption[]
  customFieldValues            CustomFieldValue[]
  qualityPlans                 QualityPlan[]
  qualityPlanVersions          QualityPlanVersion[]
  qualityPlanPoints            QualityPlanPoint[]
  qualityPlanPointOptions      QualityPlanPointOption[]
  qualityDefects               QualityDefect[]
  qualityDefectCatalogs        QualityDefectCatalog[]
  recipes                      Recipe[]
  recipeVersions               RecipeVersion[]
  recipeInputs                 RecipeInput[]
  recipeOutputs                RecipeOutput[]
  productionOrders             ProductionOrder[]
  productionOrderLines         ProductionOrderLine[]
  productionOrderOutputs       ProductionOrderOutput[]
  productionOrderAssignees     ProductionOrderAssignee[]
  recipeLock                   RecipeLock?

  @@index([ownerUserId])
  @@map("organization")
}

// Shared physical space (INV-13). V1 has one facility per company;
// multi-facility operation requires an explicit future migration.
/// A warehouse of the company (WMS-18): several per company, each with its
/// own locations, its General and its staging location. Never deleted:
/// archived when empty.
model Facility {
  id               String             @id @db.Char(36)
  organizationId   String             @db.Char(36)
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name             String             @db.VarChar(120)
  /// Short code people use and scan («CDMX-1»); unique in the company.
  code             String             @db.VarChar(20)
  address          String?            @db.VarChar(300)
  /// True for the main warehouse, NULL for the others (one per company).
  isDefault        Boolean?
  archivedAt       DateTime?          @db.DateTime(3)
  createdAt        DateTime           @default(now()) @db.DateTime(3)
  updatedAt        DateTime           @updatedAt @db.DateTime(3)
  locations        Location[]
  levels           LocationLevel[]
  activeFor        Membership[]
  outboundOrders   OutboundOrder[]
  memberScopes     MembershipScope[]
  /// Its shipments (WMS-16).
  shipments        Shipment[]
  /// What customers returned to it (WMS-17).
  customerReturns  CustomerReturn[]
  /// Transfers that leave from it and that come to it (WMS-19).
  transfersOut     FacilityTransfer[] @relation("TransferFrom")
  transfersIn      FacilityTransfer[] @relation("TransferTo")
  /// Its cycle count programs (WMS-55).
  countPrograms    CountProgram[]
  /// Approval requests about something of this warehouse (WMS-56).
  approvalRequests ApprovalRequest[]
  /// Incidents reported in it (WMS-39).
  incidents        Incident[]
  /// Processes of documents of this warehouse (WMS-74).
  processProgress  ProcessProgress[]
  /// Its equipment (WMS-42).
  equipment        Equipment[]
  /// WMS-28 (ADR 0073): production orders of this warehouse.
  productionOrders ProductionOrder[]
  /// Shared terminals of its floor (WMS-38).
  sharedTerminals  SharedTerminal[]
  /// Its picking waves (WMS-25).
  pickWaves        PickWave[]
  /// Purchase requests and orders of this warehouse (WMS-57).
  purchaseRequests PurchaseRequest[]
  purchaseOrders   PurchaseOrder[]
  /// API keys that work in this warehouse (WMS-60).
  apiKeys          ApiKey[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@unique([organizationId, isDefault])
  @@map("facility")
}

/// What a location is used for (WMS-22A): informative and for filters;
/// the capacity and restrictions of WMS-22B build on it.
enum LocationType {
  STORAGE
  PICKING
  RECEIVING
  STAGING
  QUARANTINE
  DOCK
  /// WMS-75 (ADR 0072): where things are restored; takes nothing available.
  REPAIR
  /// WMS-28 (ADR 0073): a production area, where orders make things.
  PRODUCTION
}

/// The levels of a warehouse (WMS-22A, ADR 0036): «Zona», «Pasillo»,
/// «Rack»… with free names, in order (depth 1 = the widest). A location only
/// goes inside one of a wider level, so the tree has no cycles.
model LocationLevel {
  id             String       @id @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  facilityId     String       @db.Char(36)
  facility       Facility     @relation(fields: [organizationId, facilityId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  depth          Int
  name           String       @db.VarChar(40)
  createdAt      DateTime     @default(now()) @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @db.DateTime(3)
  locations      Location[]

  @@unique([organizationId, id])
  @@unique([organizationId, facilityId, id])
  @@unique([organizationId, facilityId, depth])
  @@unique([organizationId, facilityId, name])
  @@map("location_level")
}

model Location {
  id                  String                    @id @db.Char(36)
  organizationId      String                    @db.Char(36)
  organization        Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  facilityId          String                    @db.Char(36)
  facility            Facility                  @relation(fields: [organizationId, facilityId], references: [organizationId, id], onDelete: Restrict)
  /// Name given by the business; unique among the locations of its parent.
  name                String                    @db.VarChar(120)
  /// Its level in the warehouse; NULL only for General. Fixed when the
  /// location is created (trigger).
  levelId             String?                   @db.Char(36)
  level               LocationLevel?            @relation(fields: [organizationId, facilityId, levelId], references: [organizationId, facilityId, id], onDelete: Restrict, onUpdate: Restrict)
  /// What is scanned or typed to confirm the place («A-01-03»); unique in
  /// its warehouse, upper case. Optional: without it, the name or path.
  code                String?                   @db.VarChar(30)
  type                LocationType              @default(STORAGE)
  /// Location that contains this one, in the same facility; NULL = root.
  parentId            String?                   @db.Char(36)
  parent              Location?                 @relation("LocationTree", fields: [organizationId, facilityId, parentId], references: [organizationId, facilityId, id], onDelete: Restrict, onUpdate: Restrict)
  children            Location[]                @relation("LocationTree")
  movementLines       StockMovementLine[]
  balances            StockBalance[]
  counts              StockCount[]
  /// Cycle count programs that cover it and all it holds (WMS-55).
  countPrograms       CountProgram[]
  /// Approval requests about something in this location (WMS-56).
  approvalRequests    ApprovalRequest[]
  /// Incidents about this location (WMS-39).
  incidents           Incident[]
  /// Processes of documents in this location (WMS-74).
  processProgress     ProcessProgress[]
  exitImportRows      ExitImportRow[]
  receiptLines        PurchaseReceiptLine[]
  returnLines         PurchaseReturnLine[]
  tasksFrom           WarehouseTask[]           @relation("TaskFrom")
  tasksTo             WarehouseTask[]           @relation("TaskTo")
  tasksPlaced         WarehouseTask[]           @relation("TaskPlaced")
  reservations        StockReservation[]
  holds               StockHold[]
  serialUnits         SerialUnit[]
  serialMoves         SerialMove[]
  memberScopes        MembershipScope[]
  containers          Container[]
  containerItems      ContainerItem[]
  containerEvents     ContainerEvent[]          @relation("ContainerEventAt")
  containerEventsFrom ContainerEvent[]          @relation("ContainerEventFrom")
  packShortages       OutboundPackShortage[]
  shipmentLines       ShipmentLine[]
  customerReturns     CustomerReturn[]
  returnDecisions     CustomerReturnDecision[]
  transferLines       FacilityTransferLine[]
  transferReceipts    FacilityTransferReceipt[]
  transitTransfers    FacilityTransfer[]
  /// What it may hold at most (WMS-22B); no row = no limit.
  capacity            LocationCapacity?
  /// Products or categories it is limited to (WMS-22B); none = anything.
  restrictions        LocationRestriction[]
  /// Rules that keep it filled, for a picking location (WMS-23).
  replenishmentRules  ReplenishmentRule[]
  /// Values of the custom fields of the company (WMS-58).
  customValues        CustomFieldValue[]
  /// WMS-28 (ADR 0073): production orders made in this area, and recipes
  /// that propose it.
  productionOrders    ProductionOrder[]         @relation("ProductionArea")
  recipeAreas         Recipe[]                  @relation("RecipeArea")
  /// True for General, NULL for other locations (never false; SQL CHECK).
  /// MySQL allows multiple NULLs in the unique key, but only one true.
  isDefault           Boolean?
  /// True for the place where picked goods wait to be packed and shipped
  /// (WMS-14), NULL for the others; one per facility, created when the
  /// first order is released.
  isStaging           Boolean?
  /// True for the place of a warehouse where what another warehouse sent
  /// waits, in transit (WMS-19, ADR 0048), NULL for the others; one per
  /// facility, created by the system with the first transfer to it. Never
  /// shown nor offered: only transfers write in it, always IN_TRANSIT.
  isTransit           Boolean?
  /// Archived locations stay for the history; nothing is deleted.
  archivedAt          DateTime?                 @db.DateTime(3)
  createdAt           DateTime                  @default(now()) @db.DateTime(3)
  updatedAt           DateTime                  @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, facilityId, id])
  /// Names repeat under different parents ("Estante 1" in two aisles). At
  /// the root parentId is NULL and MySQL would not compare: a trigger does.
  @@unique([organizationId, facilityId, parentId, name])
  @@unique([organizationId, facilityId, isDefault])
  @@unique([organizationId, facilityId, isStaging])
  @@unique([organizationId, facilityId, isTransit])
  @@unique([organizationId, facilityId, code])
  @@map("location")
}

/// What a location may hold at most (WMS-22B, ADR 0039): units, weight and
/// volume, each optional. It counts everything inside the location, its
/// descendants included. A row exists only while some limit is set; the
/// row is also what an operation that puts stock in locks, after all its
/// other locks, so two arrivals under the same limit are decided one after
/// the other.
model LocationCapacity {
  id             String       @id @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  locationId     String       @db.Char(36)
  location       Location     @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Sum of the quantities of every product, each in its own unit.
  maxUnits       Decimal?     @db.Decimal(18, 3)
  /// Kilograms.
  maxWeight      Decimal?     @db.Decimal(18, 3)
  /// Cubic meters.
  maxVolume      Decimal?     @db.Decimal(18, 3)
  createdAt      DateTime     @default(now()) @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, locationId])
  @@map("location_capacity")
}

/// A product or a category a location is limited to (WMS-22B, ADR 0039):
/// with rows, only those products or products of those categories may be
/// put in the location or in anything inside it; without rows, anything.
/// Exactly one of productId and categoryId is set (SQL CHECK).
model LocationRestriction {
  id             String           @id @db.Char(36)
  organizationId String           @db.Char(36)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  locationId     String           @db.Char(36)
  location       Location         @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  productId      String?          @db.Char(36)
  product        Product?         @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  categoryId     String?          @db.Char(36)
  category       ProductCategory? @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdAt      DateTime         @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, locationId, productId])
  @@unique([organizationId, locationId, categoryId])
  @@index([organizationId, productId])
  @@index([organizationId, categoryId])
  @@map("location_restriction")
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

model Membership {
  id                String              @id @db.Char(36)
  organizationId    String              @db.Char(36)
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId            String              @db.Char(36)
  user              User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  status            MembershipStatus    @default(ACTIVE)
  createdAt         DateTime            @default(now()) @db.DateTime(3)
  updatedAt         DateTime            @updatedAt @db.DateTime(3)
  roles             MembershipRole[]
  ownershipOffers   OwnershipTransfer[]
  /// The warehouse this person works in (WMS-18); null = the main one.
  activeFacilityId  String?             @db.Char(36)
  activeFacility    Facility?           @relation(fields: [organizationId, activeFacilityId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Where this person may work (WMS-20); no rows = every warehouse.
  scopes            MembershipScope[]
  /// «Cerrar todas sus sesiones» or disabling (WMS-40, ADR 0059): a session
  /// created before this moment never works in this company again (it may
  /// keep working in others); signing in again is needed.
  sessionsRevokedAt DateTime?           @db.DateTime(3)

  @@unique([organizationId, userId])
  /// Target of company-scoped foreign keys (PLT-13).
  @@unique([organizationId, id])
  @@index([userId])
  @@map("membership")
}

/// Roles of a member (USR-01/USR-06). Values come from the role catalog in
/// code once the matrix is approved (FUN-07). The composite foreign key
/// includes organizationId, so a role can never point to a membership of
/// another company (PLT-13).
model MembershipRole {
  id             String       @id @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  membershipId   String       @db.Char(36)
  membership     Membership   @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)
  role           String       @db.VarChar(40)
  createdAt      DateTime     @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([membershipId, role])
  @@index([organizationId, membershipId])
  @@map("membership_role")
}

/// Where a member may work (WMS-20, ADR 0038). No rows = no limit. A row
/// without location opens the whole warehouse; a row with one opens only
/// that location and what it holds (a zone). The titular never has rows.
model MembershipScope {
  id             String       @id @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  membershipId   String       @db.Char(36)
  membership     Membership   @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)
  facilityId     String       @db.Char(36)
  facility       Facility     @relation(fields: [organizationId, facilityId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// NULL = the whole warehouse; otherwise a location of that warehouse.
  locationId     String?      @db.Char(36)
  location       Location?    @relation(fields: [organizationId, facilityId, locationId], references: [organizationId, facilityId, id], onDelete: Restrict, onUpdate: Restrict)
  createdAt      DateTime     @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([membershipId, facilityId, locationId])
  @@index([organizationId, membershipId])
  @@index([organizationId, facilityId, locationId])
  @@map("membership_scope")
}

enum OwnershipTransferStatus {
  PENDING
  ACCEPTED
  CANCELLED
}

/// Offer to hand the company over to another member (USR-03B). The titular
/// offers, the recipient accepts; only then Organization.ownerUserId
/// changes, in one transaction. At most one PENDING offer per company
/// (checked under a lock on the organization row).
model OwnershipTransfer {
  id                 String                  @id @db.Char(36)
  organizationId     String                  @db.Char(36)
  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Titular who made the offer.
  fromUserId         String                  @db.Char(36)
  /// Membership of the person who would become titular.
  toMembershipId     String                  @db.Char(36)
  toMembership       Membership              @relation(fields: [organizationId, toMembershipId], references: [organizationId, id], onDelete: Cascade)
  /// Roles the previous titular keeps afterwards (chosen by them).
  previousOwnerRoles Json
  status             OwnershipTransferStatus @default(PENDING)
  expiresAt          DateTime                @db.DateTime(3)
  createdAt          DateTime                @default(now()) @db.DateTime(3)
  resolvedAt         DateTime?               @db.DateTime(3)

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([organizationId, toMembershipId])
  @@map("ownership_transfer")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
}

/// Invitation to join a company with roles already chosen (USR-04). The
/// link carries a random token; only its SHA-256 is stored. It works once
/// and expires. The titular is never invited: roles come from the catalog.
model Invitation {
  id              String           @id @db.Char(36)
  organizationId  String           @db.Char(36)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Normalized (trimmed, lower case) address the link was sent to.
  email           String           @db.VarChar(254)
  tokenHash       String           @unique @db.Char(64)
  roles           Json
  /// Where the person will work (WMS-20): rows `{ facilityId, locationId }`
  /// copied to `membership_scope` on acceptance. NULL = no limit.
  scope           Json?
  status          InvitationStatus @default(PENDING)
  invitedByUserId String           @db.Char(36)
  expiresAt       DateTime         @db.DateTime(3)
  createdAt       DateTime         @default(now()) @db.DateTime(3)
  resolvedAt      DateTime?        @db.DateTime(3)

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([organizationId, email])
  @@map("invitation")
}

// ── Brute-force protection (PLT-06) ──────────────────────────────────────

/// Attempt counters for sign-in, registration and verification emails.
/// Keys never contain raw emails (SHA-256 of the normalized address).
model AuthThrottle {
  key          String    @id @db.VarChar(191)
  count        Int
  windowStart  DateTime  @db.DateTime(3)
  blockedUntil DateTime? @db.DateTime(3)

  @@index([windowStart])
  @@map("auth_throttle")
}

/// Better Auth's own limiter for the /api/auth HTTP endpoints.
model RateLimit {
  id          String @id @db.Char(36)
  key         String @unique @db.VarChar(191)
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

// ── Audit log (PLT-14) ───────────────────────────────────────────────────
// Append-only: database triggers reject UPDATE and DELETE for every user.
// Metadata is sanitized before it is stored (no passwords, tokens or codes).

/// Sensitive changes inside a company: who, what, on which record and why.
model AuditEvent {
  id             String       @id @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Null for changes made by the system. No foreign key: the history
  /// outlives accounts.
  actorUserId    String?      @db.Char(36)
  action         String       @db.VarChar(80)
  targetType     String?      @db.VarChar(40)
  targetId       String?      @db.VarChar(64)
  reason         String?      @db.VarChar(500)
  metadata       Json?
  ipAddress      String?      @db.VarChar(64)
  createdAt      DateTime     @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@index([organizationId, targetType, targetId])
  @@map("audit_event")
}

/// Account security events (password, MFA, sessions), not tied to a company.
model SecurityEvent {
  id                  String   @id @db.Char(36)
  /// No foreign key: the history outlives accounts.
  userId              String   @db.Char(36)
  action              String   @db.VarChar(80)
  metadata            Json?
  ipAddress           String?  @db.VarChar(64)
  /// Company of the event when it happens inside one (terminal, team);
  /// null for account events (WMS-68, ADR 0064). No foreign key.
  eventOrganizationId String?  @db.Char(36)
  /// «phone|Chrome|Android» from describeUserAgent; never the raw text.
  deviceKey           String?  @db.VarChar(80)
  /// Something that must happen once per person (an alert, a lock).
  dedupeKey           String?  @db.VarChar(120)
  createdAt           DateTime @default(now()) @db.DateTime(3)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@map("security_event")
}

/// One person accepted one version of a legal document (PIL-09): terms of
/// service or privacy notice. Per person, not per company (the documents
/// are accepted once for the account), so it is not a tenant model. No
/// foreign key and append-only (triggers), like security_event: the proof
/// outlives accounts and is never edited.
model LegalAcceptance {
  id         String   @id @db.Char(36)
  userId     String   @db.Char(36)
  /// "terms" or "privacy" (LEGAL_DOCUMENTS in src/platform/legal).
  document   String   @db.VarChar(20)
  version    String   @db.VarChar(20)
  acceptedAt DateTime @default(now()) @db.DateTime(3)
  ipAddress  String?  @db.VarChar(64)
  userAgent  String?  @db.VarChar(500)

  @@unique([userId, document, version])
  @@map("legal_acceptance")
}

// ── Commercial model (MOD-03) ────────────────────────────────────────────

/// One published set of conditions for a capacity tier: product quota,
/// included users and prices. Never edited once a company contracted it:
/// a change of price or limit is a new version, so existing subscriptions
/// keep the conditions they accepted.
model PlanVersion {
  id             String            @id @db.Char(36)
  /// Capacity tier, e.g. "t1000" (1,000 active products).
  tier           String            @db.VarChar(20)
  version        Int
  name           String            @db.VarChar(80)
  productLimit   Int
  includedUsers  Int
  currency       String            @default("MXN") @db.Char(3)
  /// Monthly price of each additional user, before taxes.
  extraUserPrice Decimal           @db.Decimal(12, 2)
  effectiveFrom  DateTime          @db.DateTime(3)
  createdAt      DateTime          @default(now()) @db.DateTime(3)
  modulePrices   PlanModulePrice[]
  subscriptions  Subscription[]
  offers         PlanOffer[]

  @@unique([tier, version])
  @@map("plan_version")
}

/// Which version of a tier is offered to new customers today. Publishing
/// a new price moves this pointer; the versions themselves never change.
model PlanOffer {
  tier          String      @id @db.VarChar(20)
  planVersionId String      @db.Char(36)
  planVersion   PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  updatedAt     DateTime    @updatedAt @db.DateTime(3)

  @@map("plan_offer")
}

/// Monthly price of a module in a plan version, before taxes.
model PlanModulePrice {
  id            String      @id @db.Char(36)
  planVersionId String      @db.Char(36)
  planVersion   PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  /// Module id from the registry (src/modules/registry).
  moduleId      String      @db.VarChar(40)
  monthlyPrice  Decimal     @db.Decimal(12, 2)

  @@unique([planVersionId, moduleId])
  @@map("plan_module_price")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  GRACE
  SUSPENDED
  CANCELLED
}

/// What a company contracted: one plan version, its period and extra
/// users. One per company.
model Subscription {
  id                 String             @id @db.Char(36)
  organizationId     String             @unique @db.Char(36)
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  planVersionId      String             @db.Char(36)
  planVersion        PlanVersion        @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  status             SubscriptionStatus @default(TRIAL)
  extraUsers         Int                @default(0)
  currentPeriodStart DateTime           @db.DateTime(3)
  currentPeriodEnd   DateTime           @db.DateTime(3)
  createdAt          DateTime           @default(now()) @db.DateTime(3)
  updatedAt          DateTime           @updatedAt @db.DateTime(3)
  items              SubscriptionItem[]
  entitlements       Entitlement[]

  @@unique([organizationId, id])
  @@index([planVersionId])
  @@map("subscription")
}

/// A module inside a subscription, with the price agreed when it was added.
model SubscriptionItem {
  id             String       @id @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscriptionId String       @db.Char(36)
  subscription   Subscription @relation(fields: [organizationId, subscriptionId], references: [organizationId, id], onDelete: Cascade)
  moduleId       String       @db.VarChar(40)
  monthlyPrice   Decimal      @db.Decimal(12, 2)
  activeFrom     DateTime     @db.DateTime(3)
  /// Null while active; set when the module is removed.
  activeUntil    DateTime?    @db.DateTime(3)
  createdAt      DateTime     @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([subscriptionId, moduleId])
  @@map("subscription_item")
}

enum EntitlementKind {
  MODULE
  LIMIT
}

/// What a company may use right now: a module, or a limit with its value.
/// The server guard reads only this table (MOD-04/05); it is written from
/// the subscription or by platform staff (MOD-09), never by the customer.
model Entitlement {
  id             String          @id @db.Char(36)
  organizationId String          @db.Char(36)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  kind           EntitlementKind
  /// Module id, or limit key such as "active_products" or "users".
  key            String          @db.VarChar(40)
  /// Value of a limit; null for modules.
  value          Int?
  validFrom      DateTime        @db.DateTime(3)
  /// Null = no end date.
  validUntil     DateTime?       @db.DateTime(3)
  /// Subscription it comes from; null when granted by platform staff.
  subscriptionId String?         @db.Char(36)
  subscription   Subscription?   @relation(fields: [organizationId, subscriptionId], references: [organizationId, id], onDelete: Restrict)
  createdAt      DateTime        @default(now()) @db.DateTime(3)
  updatedAt      DateTime        @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, kind, key])
  @@map("entitlement")
}

/// How much of a plan limit a company is using (MOD-07). `taken` counts
/// what exists plus what is reserved (e.g. by an import in progress), so
/// one conditional UPDATE decides whether something fits: two requests for
/// the last place cannot both win.
model QuotaUsage {
  id             String       @id @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Limit key of the entitlement: "active_products", "users".
  key            String       @db.VarChar(40)
  /// In use + reserved.
  taken          Int          @default(0)
  /// Part of `taken` that is only reserved.
  reserved       Int          @default(0)
  updatedAt      DateTime     @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, key])
  @@map("quota_usage")
}

// ── Platform staff (MOD-09) ──────────────────────────────────────────────

/// People of our own team who may use the internal console (assign plans
/// and modules to any company). Rows are written only with
/// `npm run staff -- add <correo>` by someone with database access; there
/// is no screen to grant it. MFA is mandatory for them.
model PlatformStaff {
  userId     String    @id @db.Char(36)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now()) @db.DateTime(3)
  /// Set when access is withdrawn; the row stays as a record.
  disabledAt DateTime? @db.DateTime(3)

  @@map("platform_staff")
}

// ── Online purchase (ADR 0028) ───────────────────────────────────────────

enum CheckoutProvider {
  STRIPE
  PAYPAL
  MERCADOPAGO
  /// Paid entirely with a code (100% off): no provider involved.
  CODE
}

enum CheckoutStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

/// A plan bought online by the owner of a company. Every amount is fixed
/// by the server when the order is created (src/platform/billing/prices);
/// the provider only confirms that exactly that was paid. The plan is
/// applied once, when the order becomes PAID.
model CheckoutOrder {
  id               String           @id @db.Char(36)
  organizationId   String           @db.Char(36)
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Shown to the customer and in the email: "AL-7F3K9Q2M".
  transactionId    String           @unique @db.VarChar(20)
  /// Owner who bought it.
  userId           String           @db.Char(36)
  tier             String           @db.VarChar(20)
  productLimit     Int
  includedUsers    Int
  /// Modules bought, comma separated in registry order: "inventory,purchasing".
  modules          String           @db.VarChar(200)
  /// 0 = only the difference until the current plan ends (BIL-08).
  months           Int
  /// Changing plan while one is live: what the new plan costs more for the
  /// days left of the current one (part of the subtotal; BIL-08/09).
  prorated         Decimal          @default(0) @db.Decimal(12, 2)
  /// The days left that `prorated` paid for; null when not a change.
  proratedDays     Int?
  subtotal         Decimal          @db.Decimal(12, 2)
  discount         Decimal          @db.Decimal(12, 2)
  tax              Decimal          @db.Decimal(12, 2)
  total            Decimal          @db.Decimal(12, 2)
  currency         String           @default("MXN") @db.Char(3)
  provider         CheckoutProvider
  /// The provider's checkout id (session / order / preference).
  providerRef      String?          @db.VarChar(255)
  /// The provider's id of the captured payment.
  paymentRef       String?          @db.VarChar(255)
  status           CheckoutStatus   @default(PENDING)
  promoCodeId      String?          @db.Char(36)
  promoCode        PromoCode?       @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)
  /// End of the plan before and after applying this purchase.
  validUntilBefore DateTime?        @db.DateTime(3)
  validUntilAfter  DateTime?        @db.DateTime(3)
  createdAt        DateTime         @default(now()) @db.DateTime(3)
  /// After this a PENDING order is no longer payable.
  expiresAt        DateTime         @db.DateTime(3)
  paidAt           DateTime?        @db.DateTime(3)
  updatedAt        DateTime         @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([provider, providerRef])
  @@index([organizationId, createdAt])
  @@index([status, expiresAt])
  @@map("checkout_order")
}

/// A discount code created by platform staff (/interno/codigos). Not a
/// company table: one code can be used by different companies.
model PromoCode {
  id              String          @id @db.Char(36)
  /// Upper case, letters, digits and hyphens: "PEPITOGRATIS".
  code            String          @unique @db.VarChar(40)
  /// Whole percentage taken from the subtotal; 100 = free.
  percentOff      Int
  maxRedemptions  Int
  /// Orders PAID with it; moved with a conditional UPDATE (never > max).
  redemptions     Int             @default(0)
  validUntil      DateTime?       @db.DateTime(3)
  disabledAt      DateTime?       @db.DateTime(3)
  note            String?         @db.VarChar(200)
  createdByUserId String          @db.Char(36)
  createdAt       DateTime        @default(now()) @db.DateTime(3)
  orders          CheckoutOrder[]

  @@map("promo_code")
}

/// A webhook received from a provider, stored before answering so a
/// repeated delivery is recognised (unique per provider + event id). The
/// body is not stored: the state is always asked to the provider.
model PaymentEvent {
  id          String    @id @db.Char(36)
  provider    String    @db.VarChar(20)
  eventId     String    @db.VarChar(255)
  type        String    @db.VarChar(100)
  orderId     String?   @db.Char(36)
  receivedAt  DateTime  @default(now()) @db.DateTime(3)
  processedAt DateTime? @db.DateTime(3)

  @@unique([provider, eventId])
  @@map("payment_event")
}

enum ManualPaymentKind {
  PAYMENT
  REVERSAL
}

/// A bank transfer (SPEI) registered by platform staff while billing is
/// assisted (PIL-11, ADR 0027). Registering it moves the end of the plan
/// (`validUntilBefore` → `validUntilAfter`). Immutable (triggers): a
/// mistake is undone by a REVERSAL row pointing to the payment, which
/// takes the same months back.
model ManualPayment {
  id                String            @id @db.Char(36)
  organizationId    String            @db.Char(36)
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  kind              ManualPaymentKind @default(PAYMENT)
  /// Amount received, MXN; a reversal repeats the amount of its payment.
  amount            Decimal           @db.Decimal(12, 2)
  currency          String            @default("MXN") @db.Char(3)
  /// Day of the transfer, as written on the bank receipt.
  paidOn            DateTime          @db.Date
  /// SPEI tracking key (clave de rastreo), upper case; null in reversals.
  reference         String?           @db.VarChar(40)
  /// Months of plan it pays (or takes back).
  months            Int
  /// Free notes; reason of a reversal. Fiscal data (CFDI) comes later (PIL-10).
  notes             String?           @db.VarChar(500)
  reversesPaymentId String?           @db.Char(36)
  reverses          ManualPayment?    @relation("ManualPaymentReversal", fields: [organizationId, reversesPaymentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  reversal          ManualPayment?    @relation("ManualPaymentReversal")
  validUntilBefore  DateTime          @db.DateTime(3)
  validUntilAfter   DateTime          @db.DateTime(3)
  recordedByUserId  String            @db.Char(36)
  createdAt         DateTime          @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  /// One reversal per payment.
  @@unique([organizationId, reversesPaymentId])
  @@index([organizationId, reference])
  @@index([organizationId, createdAt])
  @@map("manual_payment")
}

/// Temporary, read-only access of platform support to a company (PIL-12).
/// The titular opens it for a fixed time and may close it earlier; nothing
/// is ever deleted, so it stays as the record of who allowed what and when.
model SupportAccess {
  id              String       @id @db.Char(36)
  organizationId  String       @db.Char(36)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  grantedByUserId String       @db.Char(36)
  expiresAt       DateTime     @db.DateTime(3)
  revokedAt       DateTime?    @db.DateTime(3)
  revokedByUserId String?      @db.Char(36)
  createdAt       DateTime     @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  @@index([organizationId, expiresAt])
  @@map("support_access")
}

// ── Product catalog (INV-01) ─────────────────────────────────────────────
// The catalog belongs to the shared core (platform/catalog): Inventario,
// Compras and later Ventas use the same products. Text columns use the
// database's case- and accent-insensitive collation, so "tor-001" and
// "TOR-001" are the same SKU.

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

/// Grouping chosen by the business: "Tornillería", "Pinturas".
model ProductCategory {
  id                   String                @id @db.Char(36)
  organizationId       String                @db.Char(36)
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name                 String                @db.VarChar(80)
  createdAt            DateTime              @default(now()) @db.DateTime(3)
  products             Product[]
  locationRestrictions LocationRestriction[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@map("product_category")
}

model ProductBrand {
  id             String       @id @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String       @db.VarChar(80)
  createdAt      DateTime     @default(now()) @db.DateTime(3)
  products       Product[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@map("product_brand")
}

/// One thing the business keeps in stock. Quantities never live here:
/// stock is the sum of movements (INV-15). An active product takes one
/// place of the plan's quota; an archived one does not.
model Product {
  id                     String                  @id @db.Char(36)
  organizationId         String                  @db.Char(36)
  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Code the business uses for the product; unique in the company.
  sku                    String                  @db.VarChar(64)
  name                   String                  @db.VarChar(160)
  description            String?                 @db.Text
  categoryId             String?                 @db.Char(36)
  category               ProductCategory?        @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict)
  brandId                String?                 @db.Char(36)
  brand                  ProductBrand?           @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Restrict)
  /// Printed code read by a scanner; unique in the company when present.
  barcode                String?                 @db.VarChar(64)
  /// Unit in which the product is controlled (INV-06). Stock is always
  /// kept in this unit; presentations convert to it.
  unitCode               String                  @default("piece") @db.VarChar(12)
  unit                   Unit                    @relation(fields: [unitCode], references: [code], onDelete: Restrict)
  /// Increment accepted for quantities: 1 = whole units, 0.01 = hundredths.
  quantityStep           Decimal                 @default(1) @db.Decimal(12, 3)
  /// Weight of one unit of the product, in kilograms (WMS-22B); NULL =
  /// unknown: it does not count against a weight capacity.
  unitWeight             Decimal?                @db.Decimal(14, 6)
  /// Volume of one unit of the product, in liters; NULL = unknown.
  unitVolume             Decimal?                @db.Decimal(14, 6)
  /// How its stock is controlled (WMS-21, ADR 0040): without a lot or by
  /// lot. It only changes while the product has no stock and nothing
  /// reserved; triggers keep lines and balances consistent with it.
  tracking               ProductTracking         @default(NONE)
  /// Whether its lots carry an expiry date; only read when it is by lot.
  lotExpiry              LotExpiryRule           @default(NONE)
  /// WMS-30-0 (ADR 0068): what arrives healthy from a supplier enters in
  /// inspection, never available, until someone decides it.
  inspectOnReceipt       Boolean                 @default(false)
  locationRestrictions   LocationRestriction[]
  presentations          ProductPresentation[]
  movementLines          StockMovementLine[]
  balances               StockBalance[]
  minimum                StockMinimum?
  replenishmentRules     ReplenishmentRule[]
  countLines             StockCountLine[]
  exitImportRows         ExitImportRow[]
  suppliers              ProductSupplier[]
  orderLines             PurchaseOrderLine[]
  receiptLines           PurchaseReceiptLine[]
  returnLines            PurchaseReturnLine[]
  warehouseTasks         WarehouseTask[]
  incidents              Incident[]
  lots                   Lot[]
  serialUnits            SerialUnit[]
  reservations           StockReservation[]
  holds                  StockHold[]
  cost                   ProductCost?
  status                 ProductStatus           @default(ACTIVE)
  createdAt              DateTime                @default(now()) @db.DateTime(3)
  updatedAt              DateTime                @updatedAt @db.DateTime(3)
  outboundLines          OutboundOrderLine[]
  containerItems         ContainerItem[]
  containerEvents        ContainerEvent[]
  packShortages          OutboundPackShortage[]
  shipmentLines          ShipmentLine[]
  customerReturnLines    CustomerReturnLine[]
  transferLines          FacilityTransferLine[]
  purchaseRequestLines   PurchaseRequestLine[]
  /// Values of the custom fields of the company (WMS-58).
  customValues           CustomFieldValue[]
  /// What is checked when it waits for verification (WMS-30A).
  qualityPlans           QualityPlan[]
  /// Its recipe (WMS-27): one per product.
  recipe                 Recipe?
  /// Recipe versions that use it as a material, or that make it.
  recipeInputs           RecipeInput[]
  recipeOutputs          RecipeOutput[]
  /// WMS-28 (ADR 0073): orders that make it, and order lines that use it.
  productionOrders       ProductionOrder[]
  productionOrderLines   ProductionOrderLine[]
  productionOrderOutputs ProductionOrderOutput[]

  @@unique([organizationId, id])
  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  /// List and search (INV-10/11): the order by name and the three searched
  /// columns live in one index, so a search never reads the whole table.
  @@index([organizationId, status, name, sku, barcode])
  @@index([organizationId, categoryId])
  @@index([organizationId, brandId])
  @@map("product")
}

/// How the stock of a product is told apart (WMS-21, ADR 0040 and 0041).
enum ProductTracking {
  /// As a whole: one balance per location and state.
  NONE
  /// By lot: every line and balance names its lot.
  LOT
  /// By serial number (WMS-21B): whole units, each one a `serial_unit`;
  /// every line says which units it moved (`serial_move`).
  SERIAL
}

/// Whether the lots of a product carry an expiry date (WMS-21).
enum LotExpiryRule {
  /// Its lots have no expiry date.
  NONE
  /// A lot may have one.
  OPTIONAL
  /// Every new lot must have one.
  REQUIRED
}

// ── Units of measure (INV-05) ────────────────────────────────────────────

/// Fixed catalog shared by every company, seeded by migration from
/// src/platform/catalog/units.ts (a test keeps both equal). Reference
/// data: it has no company and is never emptied by the test setup.
model Unit {
  code        String    @id @db.VarChar(12)
  /// count, mass, length, volume or area.
  dimension   String    @db.VarChar(12)
  name        String    @db.VarChar(40)
  plural      String    @db.VarChar(40)
  symbol      String    @db.VarChar(8)
  /// Reference units of its dimension in one of this unit.
  toReference Decimal   @db.Decimal(18, 9)
  fractional  Boolean
  products    Product[]

  capturedLines StockMovementLine[] @relation("LineCapturedUnit")
  movementLines StockMovementLine[] @relation("LineUnit")

  @@map("unit")
}

// ── Presentations (INV-07, INV-08) ───────────────────────────────────────

/// How a product is bought or handled besides its unit: "Caja", "Rollo",
/// "Saco". Each company defines them per product; the name alone says
/// nothing about the content.
model ProductPresentation {
  id             String                @id @db.Char(36)
  organizationId String                @db.Char(36)
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  productId      String                @db.Char(36)
  product        Product               @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  name           String                @db.VarChar(40)
  createdAt      DateTime              @default(now()) @db.DateTime(3)
  versions       PresentationVersion[]
  movementLines  StockMovementLine[]
  countCaptures  StockCountCapture[]
  purchasedAs    ProductSupplier[]
  orderLines     PurchaseOrderLine[]
  receiptLines   PurchaseReceiptLine[]
  requestLines   PurchaseRequestLine[]
  recipeInputs   RecipeInput[]

  @@unique([organizationId, id])
  /// Lets a movement line prove its presentation is of its product.
  @@unique([organizationId, productId, id])
  @@unique([organizationId, productId, name])
  @@map("product_presentation")
}

/// Content of a presentation in the product's unit ("100 piezas"), as it
/// was from a moment on. A change of content is a new version; movements
/// keep the version they used, so history never changes (INV-08).
model PresentationVersion {
  id              String                @id @db.Char(36)
  organizationId  String                @db.Char(36)
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  presentationId  String                @db.Char(36)
  presentation    ProductPresentation   @relation(fields: [organizationId, presentationId], references: [organizationId, id], onDelete: Restrict)
  version         Int
  /// Units of the product in one presentation.
  factor          Decimal               @db.Decimal(18, 3)
  createdByUserId String                @db.Char(36)
  createdAt       DateTime              @default(now()) @db.DateTime(3)
  movementLines   StockMovementLine[]
  countCaptures   StockCountCapture[]
  lastCostOf      ProductSupplier[]
  orderLines      PurchaseOrderLine[]
  receiptLines    PurchaseReceiptLine[]
  requestLines    PurchaseRequestLine[]
  recipeInputs    RecipeInput[]

  @@unique([organizationId, id])
  /// Lets a movement line prove its version is of its presentation.
  @@unique([organizationId, presentationId, id])
  @@unique([presentationId, version])
  @@map("presentation_version")
}

// ── Stock: movements, lines and balances (INV-15) ────────────────────────

/// What a movement is. Later steps add their own kinds (receptions,
/// counts) with a migration.
enum StockMovementType {
  /// Stock that arrives (INV-16/17).
  ENTRY
  /// Stock that leaves (INV-19, INV-28).
  EXIT
  /// From one location to another, both sides in one movement (INV-23).
  TRANSFER
  /// Correction with a mandatory reason (INV-24).
  ADJUSTMENT
  /// What there was when the business started using the system (INV-18).
  INITIAL
  /// Undoes another movement with its original quantities (INV-25).
  REVERSAL
  /// Goods of a purchase order that arrived (CMP-07): written by the
  /// receipt, in its transaction, and corrected only from Compras.
  RECEIPT
  /// Goods received and sent back to the supplier (CMP-12): written by
  /// the return, in its transaction; never reversed from Inventario.
  RETURN
  /// Stock that changes state in the same location and lot (WMS-11, ADR
  /// 0033): out of one state, into another; always with a reason.
  STATUS_CHANGE
  /// What left the warehouse with a shipment (WMS-16, ADR 0045): written
  /// by the dispatch, in its transaction; never reversed from Inventario.
  SHIPMENT
  /// What a customer brought back (WMS-17, ADR 0046): written by the
  /// customer return, in its transaction, always into inspection; never
  /// reversed from Inventario.
  CUSTOMER_RETURN
  /// Between two warehouses of the company (WMS-19, ADR 0048): the send
  /// (out of the origin, into transit at the destination), the receipt
  /// (out of transit), what came back to the origin and what was lost.
  /// Written by the transfer; never reversed from Inventario.
  FACILITY_TRANSFER
  /// Damaged or rejected stock written off (WMS-30-0, ADR 0068): leaves at
  /// the average cost, as a loss, always with a reason; never reversed.
  DISPOSAL
}

enum StockDirection {
  IN
  OUT
}

/// One confirmed change of stock: who, when, why and its lines. Confirmed
/// movements never change and are never deleted (triggers); a mistake is
/// corrected with a reversal.
model StockMovement {
  id                 String                   @id @db.Char(36)
  organizationId     String                   @db.Char(36)
  organization       Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  type               StockMovementType
  /// Why it was made; mandatory for some kinds (adjustments, reversals).
  reason             String?                  @db.VarChar(500)
  /// Document or note of the business: a ticket, a delivery note.
  reference          String?                  @db.VarChar(120)
  /// Sent with the confirmation so that repeating it never duplicates the
  /// movement (INV-21). Unique in the company when present.
  idempotencyKey     String?                  @db.VarChar(64)
  /// Movement this one undoes; a movement is reversed at most once.
  reversesMovementId String?                  @db.Char(36)
  reverses           StockMovement?           @relation("StockReversal", fields: [organizationId, reversesMovementId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  reversedBy         StockMovement?           @relation("StockReversal")
  /// Person who confirmed it (an account; not a company row).
  createdByUserId    String                   @db.Char(36)
  createdAt          DateTime                 @default(now()) @db.DateTime(3)
  /// The container this movement moved whole (WMS-53, ADR 0043); null for
  /// every other movement. Not reversed from Inventario.
  containerId        String?                  @db.Char(36)
  container          Container?               @relation(fields: [organizationId, containerId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  containerEvents    ContainerEvent[]
  lines              StockMovementLine[]
  appliedCount       StockCount?
  purchaseReceipt    PurchaseReceipt?
  purchaseReturn     PurchaseReturn?
  warehouseTask      WarehouseTask?           @relation("TaskMovement")
  /// Picking tasks this entry sent straight to an order (WMS-54, ADR 0052).
  crossDockTasks     WarehouseTask[]          @relation("TaskCrossDock")
  /// The shipment whose exit this is (WMS-16, type SHIPMENT).
  shipment           Shipment?
  /// The customer return whose entry this is (WMS-17, CUSTOMER_RETURN).
  customerReturn     CustomerReturn?
  /// The decision of a customer return this change of state is (WMS-17).
  returnDecision     CustomerReturnDecision?
  /// The send of a transfer between warehouses (WMS-19).
  transferSent       FacilityTransfer?
  /// A receipt, loss or return of a transfer (WMS-19).
  transferReceipt    FacilityTransferReceipt?

  @@unique([organizationId, id])
  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, reversesMovementId])
  @@index([organizationId, createdAt])
  @@index([organizationId, type, createdAt])
  @@index([organizationId, createdByUserId, createdAt])
  @@index([organizationId, containerId])
  @@map("stock_movement")
}

/// One product in one location, in or out. It keeps what the person
/// captured, the factor applied, the presentation version it came from and
/// the resulting quantity in the product's unit, which is what moves stock:
///
///   baseQuantity = capturedQuantity × factor   (CHECK, exact decimals)
///
/// Changing a presentation later never changes these numbers.
model StockMovementLine {
  id                    String                       @id @db.Char(36)
  organizationId        String                       @db.Char(36)
  organization          Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  movementId            String                       @db.Char(36)
  movement              StockMovement                @relation(fields: [organizationId, movementId], references: [organizationId, id], onDelete: Restrict)
  lineNumber            Int
  productId             String                       @db.Char(36)
  product               Product                      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  locationId            String                       @db.Char(36)
  location              Location                     @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  direction             StockDirection
  /// State of what this line moved (ADR 0033).
  status                StockStatus                  @default(AVAILABLE)
  lotId                 String?                      @db.Char(36)
  lot                   Lot?                         @relation(fields: [organizationId, lotId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  lotKey                String                       @default("") @db.VarChar(36)
  /// As captured: "3" (boxes), "275" (centimeters), "25" (pieces).
  capturedQuantity      Decimal                      @db.Decimal(12, 3)
  /// Unit of the capture when it was another unit of the same dimension.
  capturedUnitCode      String?                      @db.VarChar(12)
  capturedUnit          Unit?                        @relation("LineCapturedUnit", fields: [capturedUnitCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  /// Presentation captured, with the version whose content was applied.
  presentationId        String?                      @db.Char(36)
  presentation          ProductPresentation?         @relation(fields: [organizationId, productId, presentationId], references: [organizationId, productId, id], onDelete: Restrict, onUpdate: Restrict)
  presentationVersionId String?                      @db.Char(36)
  presentationVersion   PresentationVersion?         @relation(fields: [organizationId, presentationId, presentationVersionId], references: [organizationId, presentationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Multiplier applied; 1 when captured in the product's unit.
  factor                Decimal                      @db.Decimal(18, 6)
  /// Quantity in the product's unit: what was added to or taken from stock.
  baseQuantity          Decimal                      @db.Decimal(12, 3)
  /// Unit of the product when it moved (fixed after its first movement).
  unitCode              String                       @db.VarChar(12)
  unit                  Unit                         @relation("LineUnit", fields: [unitCode], references: [code], onDelete: Restrict)
  /// Cost of one unit of the product this line was valued at, before taxes
  /// (VAL-01, ADR 0031): the cost of an entry, or the average cost an exit
  /// took. Null when the product had no known cost.
  unitCost              Decimal?                     @db.Decimal(18, 6)
  createdAt             DateTime                     @default(now()) @db.DateTime(3)
  /// What this line shipped, for which order (WMS-16).
  shipmentLine          ShipmentLine?
  /// What this line brought back of a customer return (WMS-17).
  customerReturnLine    CustomerReturnLine?
  transferTransitOf     FacilityTransferLine?
  transferReceiptLine   FacilityTransferReceiptLine?

  @@unique([organizationId, id])
  @@unique([organizationId, movementId, lineNumber])
  @@index([organizationId, productId, createdAt])
  @@index([organizationId, locationId, createdAt])
  @@map("stock_movement_line")
}

/// How much of a product there is in a location, in the product's unit.
/// It is the sum of the lines (IN − OUT), kept up to date in the same
/// transaction as each movement so that reading stock is one row. Never
/// negative (CHECK) and never edited from a screen.
model StockBalance {
  id             String       @id @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  productId      String       @db.Char(36)
  product        Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  locationId     String       @db.Char(36)
  location       Location     @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  /// What state the goods are in (ADR 0033); only AVAILABLE can be picked,
  /// moved freely or reserved.
  status         StockStatus  @default(AVAILABLE)
  /// Lot of the goods; null = no lot.
  lotId          String?      @db.Char(36)
  lot            Lot?         @relation(fields: [organizationId, lotId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// COALESCE(lotId, ''): MySQL does not compare NULL in a unique index
  /// (trigger keeps it equal).
  lotKey         String       @default("") @db.VarChar(36)
  quantity       Decimal      @db.Decimal(18, 3)
  updatedAt      DateTime     @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, productId, locationId, status, lotKey])
  @@index([organizationId, locationId])
  @@index([organizationId, productId, status])
  @@map("stock_balance")
}

/// Average cost of a product (VAL-01, ADR 0031): the value of all its stock
/// and the price of one unit of the product, before taxes, kept up to date
/// in the same transaction as each movement (src/modules/inventory/
/// average-cost.ts). A table of its own so that cost is only read on
/// purpose, by whoever may see costs. No row while the cost is unknown.
model ProductCost {
  id             String       @id @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  productId      String       @db.Char(36)
  product        Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  averageCost    Decimal      @db.Decimal(18, 6)
  stockValue     Decimal      @db.Decimal(20, 6)
  updatedAt      DateTime     @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, productId])
  @@map("product_cost")
}

/// Lowest stock a company wants of a product, in the product's unit
/// (INV-30). At or below it the product shows up as low. One per product;
/// removing the minimum deletes the row.
model StockMinimum {
  id              String       @id @db.Char(36)
  organizationId  String       @db.Char(36)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  productId       String       @db.Char(36)
  product         Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  quantity        Decimal      @db.Decimal(18, 3)
  /// Person who set it last (an account; not a company row).
  updatedByUserId String       @db.Char(36)
  updatedAt       DateTime     @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, productId])
  @@map("stock_minimum")
}

enum StockCountStatus {
  /// Being captured.
  OPEN
  /// Its differences were written as adjustments (INV-33); immutable.
  APPLIED
  /// Abandoned without changing stock.
  CANCELLED
}

/// A physical count of one location (INV-31): people write down what
/// they find; the system compares it with its balance. Capturing never
/// changes stock: only applying the count does (INV-33).
model StockCount {
  id                String           @id @db.Char(36)
  organizationId    String           @db.Char(36)
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  locationId        String           @db.Char(36)
  location          Location         @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  status            StockCountStatus @default(OPEN)
  /// The location while the count is open, null afterwards: the unique
  /// index below allows one open count per location.
  openLocationId    String?          @db.Char(36)
  note              String?          @db.VarChar(200)
  startedAt         DateTime         @default(now()) @db.DateTime(3)
  startedByUserId   String           @db.Char(36)
  closedAt          DateTime?        @db.DateTime(3)
  closedByUserId    String?          @db.Char(36)
  /// The adjustment that applied its differences (INV-33); null when it
  /// was applied without differences, cancelled or still open.
  appliedMovementId String?          @db.Char(36)
  appliedMovement   StockMovement?   @relation(fields: [organizationId, appliedMovementId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  lines             StockCountLine[]
  /// The cycle count program that generated it (WMS-55, ADR 0050); null
  /// for a count opened by hand.
  programId         String?          @db.Char(36)
  program           CountProgram?    @relation(fields: [organizationId, programId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// The day of the company's calendar it was generated for; with the
  /// program and the location, unique: a round never generates it twice.
  programDay        DateTime?        @db.Date

  @@unique([organizationId, id])
  @@unique([organizationId, openLocationId])
  @@unique([organizationId, appliedMovementId])
  @@unique([organizationId, programId, programDay, locationId])
  @@index([organizationId, status, startedAt])
  @@index([organizationId, programDay])
  @@map("stock_count")
}

/// How a cycle count program decides how often a location is counted
/// (WMS-55, ADR 0050).
enum CountProgramBasis {
  /// Every location as often as the others.
  EVEN
  /// By the ABC class of what it holds: A more often than B, B than C.
  ABC
}

/// A cycle count program of a warehouse (WMS-55, ADR 0050): what it
/// covers (a location with everything it holds, or the whole warehouse),
/// how often each location is counted and how many locations a day. The
/// round of the worker generates the counts of each day; it is never
/// deleted, it is paused.
model CountProgram {
  id              String            @id @db.Char(36)
  organizationId  String            @db.Char(36)
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  facilityId      String            @db.Char(36)
  facility        Facility          @relation(fields: [organizationId, facilityId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  name            String            @db.VarChar(80)
  /// The zone or location it covers, with all it holds; null = the whole
  /// warehouse. Always of the program's warehouse.
  rootLocationId  String?           @db.Char(36)
  rootLocation    Location?         @relation(fields: [organizationId, facilityId, rootLocationId], references: [organizationId, facilityId, id], onDelete: Restrict, onUpdate: Restrict)
  basis           CountProgramBasis @default(EVEN)
  /// Days between two counts of a location (of class A with ABC).
  everyDays       Int
  /// With ABC: days between counts of class B and of class C.
  everyDaysB      Int?
  everyDaysC      Int?
  /// Locations it generates at most each day.
  locationsPerDay Int
  /// Paused: the round skips it. Null = active.
  pausedAt        DateTime?         @db.DateTime(3)
  createdByUserId String            @db.Char(36)
  createdAt       DateTime          @default(now()) @db.DateTime(3)
  updatedAt       DateTime          @updatedAt @db.DateTime(3)
  counts          StockCount[]

  @@unique([organizationId, id])
  @@unique([organizationId, facilityId, name])
  @@map("count_program")
}

/// One product in a count. It keeps the reference of the comparison: the
/// moment the product was first counted and the balance the system had
/// then. Movements after that moment are not part of what was counted
/// (INV-32).
model StockCountLine {
  id             String              @id @db.Char(36)
  organizationId String              @db.Char(36)
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  countId        String              @db.Char(36)
  count          StockCount          @relation(fields: [organizationId, countId], references: [organizationId, id], onDelete: Restrict)
  productId      String              @db.Char(36)
  product        Product             @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  /// The lot counted, for a product by lot (WMS-21): one line per lot.
  lotId          String?             @db.Char(36)
  lot            Lot?                @relation(fields: [organizationId, lotId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// COALESCE(lotId, ''), as in the balance (CHECK).
  lotKey         String              @default("") @db.VarChar(36)
  countedAt      DateTime            @db.DateTime(3)
  /// Balance of the location at `countedAt`, in the product's unit.
  systemQuantity Decimal             @db.Decimal(18, 3)
  unitCode       String              @db.VarChar(12)
  captures       StockCountCapture[]

  @@unique([organizationId, id])
  @@unique([organizationId, countId, productId, lotKey])
  @@unique([organizationId, productId, id])
  @@map("stock_count_line")
}

/// What was written down for a product: «2 cajas», «30 piezas». Each
/// capture keeps how it was counted and what it is in the product's unit
/// (baseQuantity = capturedQuantity × factor); the count of the product is
/// the sum of its captures.
model StockCountCapture {
  id                    String               @id @db.Char(36)
  organizationId        String               @db.Char(36)
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lineId                String               @db.Char(36)
  productId             String               @db.Char(36)
  line                  StockCountLine       @relation(fields: [organizationId, productId, lineId], references: [organizationId, productId, id], onDelete: Restrict)
  capturedQuantity      Decimal              @db.Decimal(12, 3)
  capturedUnitCode      String?              @db.VarChar(12)
  presentationId        String?              @db.Char(36)
  presentation          ProductPresentation? @relation(fields: [organizationId, productId, presentationId], references: [organizationId, productId, id], onDelete: Restrict, onUpdate: Restrict)
  presentationVersionId String?              @db.Char(36)
  presentationVersion   PresentationVersion? @relation(fields: [organizationId, presentationId, presentationVersionId], references: [organizationId, presentationId, id], onDelete: Restrict, onUpdate: Restrict)
  factor                Decimal              @db.Decimal(18, 6)
  baseQuantity          Decimal              @db.Decimal(12, 3)
  createdByUserId       String               @db.Char(36)
  createdAt             DateTime             @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  @@index([organizationId, lineId])
  @@map("stock_count_capture")
}

enum JobStatus {
  /// Waiting for its turn (or for its next attempt).
  PENDING
  /// A worker has it.
  RUNNING
  DONE
  /// It used up its attempts; nothing retries it again.
  FAILED
}

/// Work done in the background for a company (IMP-01): an import, an
/// export. The row is the queue — it survives restarts — and carries the
/// company it belongs to, which is the only company its handler works in.
model Job {
  id               String       @id @db.Char(36)
  organizationId   String       @db.Char(36)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Which handler runs it: "inventory.import_products".
  type             String       @db.VarChar(64)
  payload          Json
  status           JobStatus    @default(PENDING)
  /// Times a worker has started it.
  attempts         Int          @default(0)
  maxAttempts      Int          @default(5)
  /// Not before this moment (now, or later after a failed attempt).
  runAt            DateTime     @default(now()) @db.DateTime(3)
  lockedAt         DateTime?    @db.DateTime(3)
  lockedBy         String?      @db.VarChar(64)
  /// Why the last attempt failed, for people; never secrets.
  lastError        String?      @db.VarChar(500)
  result           Json?
  /// Person who asked for it (an account; not a company row).
  createdByUserId  String?      @db.Char(36)
  createdAt        DateTime     @default(now()) @db.DateTime(3)
  finishedAt       DateTime?    @db.DateTime(3)
  /// When what a job that failed for good was holding was given back
  /// (IMP-08B); null while that is still to be done.
  failureHandledAt DateTime?    @db.DateTime(3)

  @@unique([organizationId, id])
  @@index([status, runAt])
  @@index([status, failureHandledAt])
  @@index([organizationId, type, createdAt])
  @@map("job")
}

/// A private file of a company (IMP-02): what it uploaded to import, what
/// was generated for it to download. The row says whose it is; the bytes
/// live in the file storage under a key that starts with the company.
model StoredFile {
  id              String           @id @db.Char(36)
  organizationId  String           @db.Char(36)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// What it is for: "import_source", "export". Decides who may read it.
  purpose         String           @db.VarChar(40)
  /// Name shown to people; never used as a path.
  name            String           @db.VarChar(160)
  /// Decided by the server from the extension, not by the browser.
  contentType     String           @db.VarChar(100)
  size            Int
  sha256          String           @db.Char(64)
  /// Where the bytes are in the storage: "<organizationId>/<id>".
  storageKey      String           @db.VarChar(100)
  createdByUserId String           @db.Char(36)
  createdAt       DateTime         @default(now()) @db.DateTime(3)
  /// Set when it was removed; the bytes are gone, the row stays as a trace.
  deletedAt       DateTime?        @db.DateTime(3)
  /// Pixels of an image (WMS-37), read from its header; null otherwise.
  width           Int?
  height          Int?
  productImports  ProductImport[]
  exitImports     ExitImport[]
  outboundImports OutboundImport[]
  evidencePhoto   EvidencePhoto?

  @@unique([organizationId, id])
  @@index([organizationId, purpose, createdAt])
  @@index([organizationId, createdByUserId, purpose, createdAt])
  @@map("stored_file")
}

enum StorageCleanupReason {
  /// Written before the bytes are uploaded; removed in the transaction that
  /// creates the file's row. Left behind = an upload that did not end.
  UPLOAD
  /// Written in the transaction that marks the file removed; gone once the
  /// bytes are.
  DELETE
}

/// Keys of the storage whose bytes may be left without a live file
/// (WMS-67, ADR 0070): an upload that failed or did not end, or a file
/// removed whose bytes could not be removed yet. The round
/// `platform.storage_cleanup` removes the bytes when no live row of
/// `stored_file` has the key, and then the row.
model StorageCleanup {
  id             String               @id @db.Char(36)
  organizationId String               @db.Char(36)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// "<organizationId>/<fileId>", the same as `stored_file.storageKey`.
  storageKey     String               @db.VarChar(100)
  reason         StorageCleanupReason
  /// Rounds that tried and failed.
  attempts       Int                  @default(0)
  /// Why the last one failed, without secrets: «delete (503)».
  lastError      String?              @db.VarChar(200)
  /// Set once by the round before it touches the bytes: from then on the
  /// upload of this key can no longer end in a row (its transaction
  /// removes the note only while unclaimed).
  claimedAt      DateTime?            @db.DateTime(3)
  /// After a failure, not before this (growing wait, at most a day).
  nextAttemptAt  DateTime?            @db.DateTime(3)
  createdAt      DateTime             @default(now()) @db.DateTime(3)
  updatedAt      DateTime             @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@map("storage_cleanup")
}

enum ProductImportStatus {
  /// The file was read; its columns are being matched to ours (IMP-04).
  MAPPING
  /// Columns and decimal separator are set; ready to be validated (IMP-05).
  READY
  /// The person confirmed it: its places of the plan are held (IMP-07)
  /// and nothing of it changes any more. The worker applies it (IMP-08).
  CONFIRMED
  /// The worker is applying it, in batches.
  RUNNING
  DONE
  /// It could not be finished; what was applied stays, the rest was not.
  FAILED
  CANCELLED
}

/// An import of products from a spreadsheet (IMP-04 on): the file that
/// was uploaded and how to read it. Nothing of the catalog changes until
/// the import is confirmed (IMP-08).
model ProductImport {
  id                  String              @id @db.Char(36)
  organizationId      String              @db.Char(36)
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fileId              String              @db.Char(36)
  file                StoredFile          @relation(fields: [organizationId, fileId], references: [organizationId, id], onDelete: Restrict)
  status              ProductImportStatus @default(MAPPING)
  /// Sheet that was read; null for CSV.
  sheetName           String?             @db.VarChar(64)
  /// Row of the file (from 1) that holds the titles.
  headerRow           Int
  /// Titles of the file, by column: ["Clave", "Nombre", …].
  headers             Json
  /// Rows with data under the titles.
  dataRows            Int
  /// Cells that held a formula: their stored value is what is read.
  formulaCells        Int                 @default(0)
  /// Which column of the file feeds each of ours: { "sku": 0, "name": 1 }.
  mapping             Json
  /// "." or ","; null until the person says how decimals are written.
  decimalSeparator    String?             @db.Char(1)
  /// Places of the plan held for its new and reactivated products while
  /// it is applied; each one becomes a product or is given back.
  reservedPlaces      Int                 @default(0)
  confirmedAt         DateTime?           @db.DateTime(3)
  confirmedByUserId   String?             @db.Char(36)
  /// Permissions its operations need (create products, opening stock…),
  /// fixed when it was confirmed and checked again before each batch.
  requiredPermissions Json?
  /// Products of the file, fixed when it was confirmed (IMP-08).
  totalItems          Int                 @default(0)
  /// Of those, how many the worker has finished: applied or failed.
  processedItems      Int                 @default(0)
  failedItems         Int                 @default(0)
  finishedAt          DateTime?           @db.DateTime(3)
  /// Why it stopped, for people, when it could not be finished.
  lastError           String?             @db.VarChar(500)
  items               ProductImportItem[]
  createdByUserId     String              @db.Char(36)
  createdAt           DateTime            @default(now()) @db.DateTime(3)
  updatedAt           DateTime            @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@map("product_import")
}

enum ProductImportItemStatus {
  PENDING
  /// The product was created, updated or reactivated.
  DONE
  /// This product could not be applied; the others go on.
  FAILED
}

/// One product of a confirmed import (IMP-08): what the file said about
/// it, fixed at the moment of confirming — its fields, the content of its
/// presentation, its stock by location. The worker applies items one by
/// one and marks them, so applying again never repeats one.
model ProductImportItem {
  id             String                  @id @db.Char(36)
  organizationId String                  @db.Char(36)
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  importId       String                  @db.Char(36)
  import         ProductImport           @relation(fields: [organizationId, importId], references: [organizationId, id], onDelete: Restrict)
  /// Order of the product in the file.
  position       Int
  sku            String                  @db.VarChar(64)
  /// What it was when confirmed: "new", "update" or "reactivate".
  kind           String                  @db.VarChar(12)
  data           Json
  status         ProductImportItemStatus @default(PENDING)
  /// The product it became, once applied.
  productId      String?                 @db.Char(36)
  error          String?                 @db.VarChar(300)
  appliedAt      DateTime?               @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, importId, position])
  @@index([organizationId, importId, status, position])
  @@map("product_import_item")
}

enum ExitImportStatus {
  /// The file was read and can be reviewed; nothing has left stock.
  READY
  /// The person confirmed it: its rows are fixed and wait for the worker.
  CONFIRMED
  /// The worker is registering its exits, in batches.
  RUNNING
  DONE
  /// It could not be finished; the exits registered stay, the rest did not.
  FAILED
  CANCELLED
}

/// A file of daily exits — what was sold or used, kept outside the system
/// — imported to take it out of stock (IMP-10). Each row names the sale it
/// comes from (`externalId`), so the same sale is never discounted twice,
/// whatever file brings it again.
model ExitImport {
  id                String           @id @db.Char(36)
  organizationId    String           @db.Char(36)
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fileId            String           @db.Char(36)
  file              StoredFile       @relation(fields: [organizationId, fileId], references: [organizationId, id], onDelete: Restrict)
  status            ExitImportStatus @default(READY)
  /// "." or ",": how the person said decimals are written in the file.
  decimalSeparator  String           @db.Char(1)
  /// Rows with data under the titles.
  dataRows          Int
  /// Rows fixed when it was confirmed, and what became of them.
  totalRows         Int              @default(0)
  appliedRows       Int              @default(0)
  /// Sales that had already been imported: not discounted again.
  duplicateRows     Int              @default(0)
  failedRows        Int              @default(0)
  /// First and last day of the exits of the file (calendar of the company).
  firstDay          DateTime?        @db.Date
  lastDay           DateTime?        @db.Date
  confirmedAt       DateTime?        @db.DateTime(3)
  confirmedByUserId String?          @db.Char(36)
  finishedAt        DateTime?        @db.DateTime(3)
  /// Why it stopped, for people, when it could not be finished.
  lastError         String?          @db.VarChar(500)
  rows              ExitImportRow[]
  createdByUserId   String           @db.Char(36)
  createdAt         DateTime         @default(now()) @db.DateTime(3)
  updatedAt         DateTime         @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@map("exit_import")
}

enum ExitImportRowStatus {
  PENDING
  /// Its exit was registered.
  DONE
  /// The same sale had already been imported: nothing left stock again.
  DUPLICATE
  /// It could not be registered (no stock, archived…); `error` says why.
  FAILED
}

/// One row of a confirmed file of exits: a product that left on a day, in
/// a sale the business identifies. Product, presentation and location are
/// fixed when confirming; the quantity is converted when the exit is
/// registered, like any movement.
model ExitImportRow {
  id             String              @id @db.Char(36)
  organizationId String              @db.Char(36)
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  importId       String              @db.Char(36)
  import         ExitImport          @relation(fields: [organizationId, importId], references: [organizationId, id], onDelete: Restrict)
  /// Row of the file.
  row            Int
  /// Identifier of the sale in the business: ticket, folio, note.
  externalId     String              @db.VarChar(64)
  /// Day it left, in the calendar of the company.
  day            DateTime            @db.Date
  productId      String              @db.Char(36)
  product        Product             @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  /// Presentation it was counted in; null when in the product's unit.
  presentationId String?             @db.Char(36)
  /// As written in the file, with decimal point: "3", "2.75".
  quantity       String              @db.VarChar(24)
  locationId     String              @db.Char(36)
  location       Location            @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  /// The lot it left from, for a product by lot (WMS-21, ADR 0040): fixed
  /// at confirmation from the code in the file; null for any other product.
  lotId          String?             @db.Char(36)
  lot            Lot?                @relation(fields: [organizationId, lotId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  status         ExitImportRowStatus @default(PENDING)
  error          String?             @db.VarChar(300)
  /// The exit it became, once registered.
  movementId     String?             @db.Char(36)
  appliedAt      DateTime?           @db.DateTime(3)
  /// Set only when its exit is registered: "<productId>:<externalId>".
  /// Unique in the company, so a sale of a product leaves stock once.
  appliedKey     String?             @db.VarChar(120)

  @@unique([organizationId, id])
  @@unique([organizationId, importId, row])
  @@unique([organizationId, appliedKey])
  @@index([organizationId, importId, status, row])
  @@index([organizationId, status, day])
  @@map("exit_import_row")
}

/// A person or business the company deals with (CMP-01): a supplier it
/// buys from, a customer it sells to, or both. Contacts belong to the
/// core, not to a module: Compras, Ventas and CRM share the same row
/// instead of each keeping its own copy of the same business. What a
/// contact is for a module is a facet (`isSupplier`, `isCustomer`), and a
/// contact always has at least one.
model Contact {
  id               String             @id @db.Char(36)
  organizationId   String             @db.Char(36)
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// As the business knows it: «Ferretera del Norte».
  name             String             @db.VarChar(160)
  /// Legal name, when it differs: «Ferretera del Norte, S.A. de C.V.».
  legalName        String?            @db.VarChar(200)
  /// Mexican tax id, in capitals and without spaces; optional.
  rfc              String?            @db.VarChar(13)
  isSupplier       Boolean            @default(false)
  isCustomer       Boolean            @default(false)
  /// Who to ask for there.
  contactPerson    String?            @db.VarChar(120)
  email            String?            @db.VarChar(254)
  phone            String?            @db.VarChar(40)
  address          String?            @db.VarChar(300)
  notes            String?            @db.VarChar(500)
  /// Set when it is no longer used; its documents keep pointing to it.
  archivedAt       DateTime?          @db.DateTime(3)
  createdByUserId  String             @db.Char(36)
  createdAt        DateTime           @default(now()) @db.DateTime(3)
  updatedAt        DateTime           @updatedAt @db.DateTime(3)
  suppliedProducts ProductSupplier[]
  purchaseOrders   PurchaseOrder[]
  /// Values of the custom fields of its supplier facet (WMS-58).
  customValues     CustomFieldValue[]

  @@unique([organizationId, id])
  /// Orders and searches the list of suppliers (name and RFC) in one index.
  @@index([organizationId, isSupplier, name, rfc, id])
  @@index([organizationId, isCustomer, name, id])
  @@index([organizationId, rfc])
  @@map("contact")
}

/// That a supplier sells a product to the company (CMP-03): the code the
/// supplier knows it by, the presentation it is bought in and what it
/// cost the last time. One row per product and supplier.
///
/// The presentation only says how it is bought; its content is the one of
/// the catalog and is never changed from here. The last cost is not typed
/// in: it is written when a purchase is registered, and shown only to who
/// may see costs.
model ProductSupplier {
  id                            String               @id @db.Char(36)
  organizationId                String               @db.Char(36)
  organization                  Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  productId                     String               @db.Char(36)
  product                       Product              @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  /// The contact, in its supplier facet (checked by the service).
  contactId                     String               @db.Char(36)
  contact                       Contact              @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: Restrict)
  /// Code of the product in the supplier's catalog.
  supplierSku                   String?              @db.VarChar(64)
  /// Presentation of the product it is usually bought in; null = its unit.
  presentationId                String?              @db.Char(36)
  presentation                  ProductPresentation? @relation(fields: [organizationId, productId, presentationId], references: [organizationId, productId, id], onDelete: Restrict, onUpdate: Restrict)
  /// What one unit of purchase cost the last time, in pesos, before taxes.
  lastCost                      Decimal?             @db.Decimal(14, 4)
  /// What that cost was for: the version of the presentation bought, or
  /// null when it was bought by the product's unit.
  lastCostPresentationId        String?              @db.Char(36)
  lastCostPresentationVersionId String?              @db.Char(36)
  lastCostVersion               PresentationVersion? @relation(fields: [organizationId, lastCostPresentationId, lastCostPresentationVersionId], references: [organizationId, presentationId, id], onDelete: Restrict, onUpdate: Restrict)
  lastCostAt                    DateTime?            @db.DateTime(3)
  createdByUserId               String               @db.Char(36)
  createdAt                     DateTime             @default(now()) @db.DateTime(3)
  updatedAt                     DateTime             @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, productId, contactId])
  @@index([organizationId, contactId, productId])
  @@map("product_supplier")
}

enum PurchaseOrderStatus {
  /// Being written: its lines can still change (CMP-04).
  DRAFT
  /// Sent to the supplier; nothing received yet (CMP-05).
  SENT
  /// Part of it was received.
  PARTIAL
  RECEIVED
  CANCELLED
  /// Received in part and closed with what was missing (CMP-11): the rest
  /// is no longer expected.
  CLOSED
}

/// What the company asks a supplier for (CMP-04). It is numbered within
/// the company and starts as a draft, the only state in which its lines
/// can be added, changed or removed.
model PurchaseOrder {
  id                String                  @id @db.Char(36)
  organizationId    String                  @db.Char(36)
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Consecutive within the company: shown as «OC-0001».
  number            Int
  /// The contact, in its supplier facet (checked by the service).
  contactId         String                  @db.Char(36)
  contact           Contact                 @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: Restrict)
  status            PurchaseOrderStatus     @default(DRAFT)
  /// Day it is expected to arrive, in the calendar of the company.
  expectedOn        DateTime?               @db.Date
  notes             String?                 @db.VarChar(500)
  /// When a person confirmed it as sent, and who (CMP-05).
  sentAt            DateTime?               @db.DateTime(3)
  sentByUserId      String?                 @db.Char(36)
  /// When and why it was cancelled, and by whom.
  cancelledAt       DateTime?               @db.DateTime(3)
  cancelledByUserId String?                 @db.Char(36)
  cancelReason      String?                 @db.VarChar(300)
  /// When, why and by whom it was closed with a shortage (CMP-11). The
  /// shortage itself is ordered − received, both fixed by then.
  closedAt          DateTime?               @db.DateTime(3)
  closedByUserId    String?                 @db.Char(36)
  closeReason       String?                 @db.VarChar(300)
  lines             PurchaseOrderLine[]
  deliveries        PurchaseOrderDelivery[]
  receipts          PurchaseReceipt[]
  createdByUserId   String                  @db.Char(36)
  createdAt         DateTime                @default(now()) @db.DateTime(3)
  updatedAt         DateTime                @updatedAt @db.DateTime(3)
  /// Warehouse it is for (WMS-57): the active one of who created it. NULL
  /// for the orders written before (of the whole company). Never changes.
  facilityId        String?                 @db.Char(36)
  facility          Facility?               @relation(fields: [organizationId, facilityId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// The purchase request it was made from (WMS-57). Never changes.
  purchaseRequestId String?                 @db.Char(36)
  purchaseRequest   PurchaseRequest?        @relation(fields: [organizationId, purchaseRequestId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([organizationId, status, number])
  @@index([organizationId, contactId, number])
  @@index([organizationId, facilityId, number])
  @@index([organizationId, purchaseRequestId])
  @@map("purchase_order")
}

enum PurchaseRequestStatus {
  /// Being written by who asks: its lines can still change.
  DRAFT
  /// Sent and waiting for an authorization (the rule of the company is on).
  SUBMITTED
  /// For Compras to attend: authorized, or sent with the rule off.
  APPROVED
  /// Not bought: rejected when authorizing, or by Compras, with its reason.
  REJECTED
  /// Turned into one draft order per supplier.
  CONVERTED
  /// Withdrawn by who asked before it was authorized.
  CANCELLED
}

/// Someone needs goods and asks Compras for them (WMS-57, ADR 0055). It
/// carries no costs. It is numbered within the company («SC-0001»), is of
/// the warehouse of who asks, and is never deleted. Its states are those of
/// `PURCHASE_REQUEST_TRANSITIONS` (trigger); it is turned into orders once.
model PurchaseRequest {
  id                String                @id @db.Char(36)
  organizationId    String                @db.Char(36)
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  number            Int
  facilityId        String                @db.Char(36)
  facility          Facility              @relation(fields: [organizationId, facilityId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  status            PurchaseRequestStatus @default(DRAFT)
  /// Day it is needed by, in the calendar of the company; optional.
  neededOn          DateTime?             @db.Date
  notes             String?               @db.VarChar(500)
  requestedByUserId String                @db.Char(36)
  submittedAt       DateTime?             @db.DateTime(3)
  /// When it reached Compras; who authorized it (null with the rule off).
  approvedAt        DateTime?             @db.DateTime(3)
  approvedByUserId  String?               @db.Char(36)
  rejectedAt        DateTime?             @db.DateTime(3)
  rejectedByUserId  String?               @db.Char(36)
  rejectReason      String?               @db.VarChar(500)
  cancelledAt       DateTime?             @db.DateTime(3)
  convertedAt       DateTime?             @db.DateTime(3)
  convertedByUserId String?               @db.Char(36)
  lines             PurchaseRequestLine[]
  orders            PurchaseOrder[]
  createdAt         DateTime              @default(now()) @db.DateTime(3)
  updatedAt         DateTime              @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([organizationId, facilityId, status, number])
  @@index([organizationId, requestedByUserId, number])
  @@map("purchase_request")
}

/// One product of a purchase request, as an order line keeps it: what was
/// written, the presentation and version of its content then, and the
/// result in the product's unit (CHECK). No cost. Only while the request is
/// a draft can its lines change (trigger); one line per product.
model PurchaseRequestLine {
  id                    String               @id @db.Char(36)
  organizationId        String               @db.Char(36)
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requestId             String               @db.Char(36)
  request               PurchaseRequest      @relation(fields: [organizationId, requestId], references: [organizationId, id], onDelete: Restrict)
  lineNumber            Int
  productId             String               @db.Char(36)
  product               Product              @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  capturedQuantity      Decimal              @db.Decimal(12, 3)
  presentationId        String?              @db.Char(36)
  presentation          ProductPresentation? @relation(fields: [organizationId, productId, presentationId], references: [organizationId, productId, id], onDelete: Restrict, onUpdate: Restrict)
  presentationVersionId String?              @db.Char(36)
  presentationVersion   PresentationVersion? @relation(fields: [organizationId, presentationId, presentationVersionId], references: [organizationId, presentationId, id], onDelete: Restrict, onUpdate: Restrict)
  factor                Decimal              @db.Decimal(18, 6)
  baseQuantity          Decimal              @db.Decimal(12, 3)
  unitCode              String               @db.VarChar(12)
  createdAt             DateTime             @default(now()) @db.DateTime(3)
  updatedAt             DateTime             @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, requestId, lineNumber])
  @@unique([organizationId, requestId, productId])
  @@index([organizationId, productId])
  @@map("purchase_request_line")
}

enum PurchaseOrderDeliveryStatus {
  /// Waiting for the worker, or between attempts.
  QUEUED
  SENT
  /// It will not be tried again; a person may ask for another one.
  FAILED
}

/// One time a person asked to send an order to its supplier by mail
/// (CMP-06B). The worker sends it; the row says how it ended. The address
/// is the one the supplier had when it was asked, and the row no longer
/// changes once it is sent or failed (trigger). Sending does not move the
/// state of the order.
model PurchaseOrderDelivery {
  id                String                      @id @db.Char(36)
  organizationId    String                      @db.Char(36)
  organization      Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  orderId           String                      @db.Char(36)
  order             PurchaseOrder               @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Restrict)
  recipient         String                      @db.VarChar(254)
  status            PurchaseOrderDeliveryStatus @default(QUEUED)
  /// The job that sends it (a row of `job` of the same company).
  jobId             String                      @db.Char(36)
  requestedByUserId String                      @db.Char(36)
  requestedAt       DateTime                    @default(now()) @db.DateTime(3)
  sentAt            DateTime?                   @db.DateTime(3)
  failedAt          DateTime?                   @db.DateTime(3)
  /// Why it was not sent, for people; never the answer of a mail server.
  failureReason     String?                     @db.VarChar(300)

  @@unique([organizationId, id])
  @@unique([organizationId, jobId])
  @@index([organizationId, orderId, requestedAt])
  @@index([organizationId, requestedAt])
  @@map("purchase_order_delivery")
}

/// One product of a purchase order. Like a movement line, it keeps what
/// was asked for as it was written, the presentation and the version of
/// its content at that moment, and the result in the product's unit:
///
///   baseQuantity = capturedQuantity × factor   (CHECK, exact decimals)
///
/// so «3 cajas × 100 = 300 piezas» stays what was ordered even if the box
/// changes later. The cost is of one unit of what was captured (one box).
model PurchaseOrderLine {
  id                    String                @id @db.Char(36)
  organizationId        String                @db.Char(36)
  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  orderId               String                @db.Char(36)
  order                 PurchaseOrder         @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Restrict)
  lineNumber            Int
  productId             String                @db.Char(36)
  product               Product               @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  /// Code of the product at the supplier when the line was written.
  supplierSku           String?               @db.VarChar(64)
  capturedQuantity      Decimal               @db.Decimal(12, 3)
  /// Presentation ordered, with the version whose content was applied.
  presentationId        String?               @db.Char(36)
  presentation          ProductPresentation?  @relation(fields: [organizationId, productId, presentationId], references: [organizationId, productId, id], onDelete: Restrict, onUpdate: Restrict)
  presentationVersionId String?               @db.Char(36)
  presentationVersion   PresentationVersion?  @relation(fields: [organizationId, presentationId, presentationVersionId], references: [organizationId, presentationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Multiplier applied; 1 when ordered in the product's unit.
  factor                Decimal               @db.Decimal(18, 6)
  /// Quantity in the product's unit: what will enter stock when received.
  baseQuantity          Decimal               @db.Decimal(12, 3)
  unitCode              String                @db.VarChar(12)
  /// Cost of one captured unit (one box), in pesos, before taxes; null
  /// while it is not known. Private to who may see costs.
  unitCost              Decimal?              @db.Decimal(14, 4)
  receiptLines          PurchaseReceiptLine[]
  createdAt             DateTime              @default(now()) @db.DateTime(3)
  updatedAt             DateTime              @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, orderId, lineNumber])
  @@index([organizationId, productId, orderId])
  @@map("purchase_order_line")
}

/// One time goods of a purchase order arrived (CMP-07). It is written in
/// the same transaction as its stock movement (`RECEIPT`) and the
/// balances: all of it exists or none. Never changed nor deleted
/// (triggers): a mistake is corrected from Compras (a return, CMP-12).
model PurchaseReceipt {
  id               String                @id @db.Char(36)
  organizationId   String                @db.Char(36)
  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  orderId          String                @db.Char(36)
  order            PurchaseOrder         @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Restrict)
  /// The entry of stock it made; one movement per receipt.
  movementId       String                @db.Char(36)
  movement         StockMovement         @relation(fields: [organizationId, movementId], references: [organizationId, id], onDelete: Restrict)
  /// Delivery note or invoice of the supplier it came with.
  reference        String?               @db.VarChar(120)
  /// Sent with the confirmation so that repeating it receives once.
  idempotencyKey   String                @db.VarChar(64)
  receivedByUserId String                @db.Char(36)
  createdAt        DateTime              @default(now()) @db.DateTime(3)
  lines            PurchaseReceiptLine[]
  returns          PurchaseReturn[]

  @@unique([organizationId, id])
  @@unique([organizationId, movementId])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, orderId, createdAt])
  @@map("purchase_receipt")
}

/// What arrived of one line of the order, where it was put and how it was
/// converted. The quantity is in the terms of the order line (3 boxes);
/// the factor is the one in force when it was received, so the stock that
/// entered is `baseQuantity` (CHECK: captured × factor, exact decimals).
model PurchaseReceiptLine {
  id                    String               @id @db.Char(36)
  organizationId        String               @db.Char(36)
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  receiptId             String               @db.Char(36)
  receipt               PurchaseReceipt      @relation(fields: [organizationId, receiptId], references: [organizationId, id], onDelete: Restrict)
  lineNumber            Int
  /// The line of the order it receives (same order and product: trigger).
  orderLineId           String               @db.Char(36)
  orderLine             PurchaseOrderLine    @relation(fields: [organizationId, orderLineId], references: [organizationId, id], onDelete: Restrict)
  productId             String               @db.Char(36)
  product               Product              @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  locationId            String               @db.Char(36)
  location              Location             @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  capturedQuantity      Decimal              @db.Decimal(12, 3)
  presentationId        String?              @db.Char(36)
  presentation          ProductPresentation? @relation(fields: [organizationId, productId, presentationId], references: [organizationId, productId, id], onDelete: Restrict, onUpdate: Restrict)
  presentationVersionId String?              @db.Char(36)
  presentationVersion   PresentationVersion? @relation(fields: [organizationId, presentationId, presentationVersionId], references: [organizationId, presentationId, id], onDelete: Restrict, onUpdate: Restrict)
  factor                Decimal              @db.Decimal(18, 6)
  baseQuantity          Decimal              @db.Decimal(12, 3)
  unitCode              String               @db.VarChar(12)
  /// What one captured unit (one box) cost, copied from the order line
  /// when it arrived (CMP-13); null when the order had no cost. Private to
  /// who may see costs.
  unitCost              Decimal?             @db.Decimal(14, 4)
  /// The lot it arrived in, for a product by lot (WMS-21): what goes back
  /// to the supplier leaves from this lot.
  lotId                 String?              @db.Char(36)
  lot                   Lot?                 @relation(fields: [organizationId, lotId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// AVAILABLE, or DAMAGED for the part that arrived damaged (WMS-54, ADR
  /// 0052): its own line, in the same state as its movement line.
  status                StockStatus          @default(AVAILABLE)
  createdAt             DateTime             @default(now()) @db.DateTime(3)
  returnLines           PurchaseReturnLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, receiptId, lineNumber])
  @@index([organizationId, orderLineId])
  @@index([organizationId, productId, createdAt])
  @@map("purchase_receipt_line")
}

/// Goods of a receipt sent back to the supplier (CMP-12). Written in the
/// same transaction as its stock movement (`RETURN`, an exit) and the
/// balances. Never changed nor deleted (triggers). What is returned of a
/// receipt line never adds up to more than what it received.
model PurchaseReturn {
  id               String               @id @db.Char(36)
  organizationId   String               @db.Char(36)
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  receiptId        String               @db.Char(36)
  receipt          PurchaseReceipt      @relation(fields: [organizationId, receiptId], references: [organizationId, id], onDelete: Restrict)
  /// The exit of stock it made; one movement per return.
  movementId       String               @db.Char(36)
  movement         StockMovement        @relation(fields: [organizationId, movementId], references: [organizationId, id], onDelete: Restrict)
  /// Why it goes back: damaged, wrong product, more than ordered…
  reason           String               @db.VarChar(300)
  /// Sent with the confirmation so that repeating it returns once.
  idempotencyKey   String               @db.VarChar(64)
  returnedByUserId String               @db.Char(36)
  createdAt        DateTime             @default(now()) @db.DateTime(3)
  lines            PurchaseReturnLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, movementId])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, receiptId, createdAt])
  @@map("purchase_return")
}

/// What goes back of one receipt line, in its terms (boxes) and with the
/// factor it was received with: what leaves is what entered for it.
model PurchaseReturnLine {
  id               String              @id @db.Char(36)
  organizationId   String              @db.Char(36)
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  returnId         String              @db.Char(36)
  return           PurchaseReturn      @relation(fields: [organizationId, returnId], references: [organizationId, id], onDelete: Restrict)
  lineNumber       Int
  /// The receipt line it returns (same receipt and product: trigger).
  receiptLineId    String              @db.Char(36)
  receiptLine      PurchaseReceiptLine @relation(fields: [organizationId, receiptLineId], references: [organizationId, id], onDelete: Restrict)
  productId        String              @db.Char(36)
  product          Product             @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  /// Where it is taken from.
  locationId       String              @db.Char(36)
  location         Location            @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  capturedQuantity Decimal             @db.Decimal(12, 3)
  factor           Decimal             @db.Decimal(18, 6)
  baseQuantity     Decimal             @db.Decimal(12, 3)
  unitCode         String              @db.VarChar(12)
  createdAt        DateTime            @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, returnId, lineNumber])
  @@index([organizationId, receiptLineId])
  @@index([organizationId, productId, createdAt])
  @@map("purchase_return_line")
}

// ── Tareas de almacén (WMS-06, especificación WMS v5 5.3) ───────────────

/// Where a warehouse task is (WMS-06). The only transitions are those of
/// `WAREHOUSE_TASK_TRANSITIONS` (task-states.ts), repeated by the trigger
/// `warehouse_task_transition`.
enum WarehouseTaskStatus {
  /// Created, nobody has it yet.
  PENDING
  /// Given to a person by a supervisor; only that person may accept it.
  ASSIGNED
  /// Someone took it and is on the way to the origin.
  ACCEPTED
  /// The load is on the forklift (or in hand).
  PICKED_UP
  /// Left at the destination: its transfer movement was written.
  DELIVERED
  /// Something stopped it (damage, wrong location, no stock); a supervisor
  /// releases it again or cancels it.
  BLOCKED
  /// Cancelled with a reason by who may.
  CANCELLED
}

enum WarehouseTaskPriority {
  NORMAL
  URGENT
}

/// What a task is for (WMS-14): a move asked by a supervisor, or picking a
/// line of an outbound order to the staging location.
enum WarehouseTaskKind {
  TRANSFER
  PICK
  /// Puts away what waits in «General» or a receiving location (WMS-52).
  PUTAWAY
  /// Fills a picking location from storage (WMS-24, ADR 0051).
  REPLENISH
  /// Takes a material of a production order to its area (WMS-28, ADR 0073).
  ISSUE
}

/// A move of stock from one location to another that a person executes
/// step by step (WMS-06): accept, pick up, deliver. The delivery writes the
/// TRANSFER movement in the same transaction; until then nothing moves.
/// What it moves (product, origin, destination, quantity) never changes
/// after it is created (trigger).
model WarehouseTask {
  id                    String                @id @db.Char(36)
  organizationId        String                @db.Char(36)
  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Consecutive per company («T-0001»).
  number                Int
  kind                  WarehouseTaskKind     @default(TRANSFER)
  status                WarehouseTaskStatus   @default(PENDING)
  priority              WarehouseTaskPriority @default(NORMAL)
  /// PICK only: the line of the outbound order it picks.
  outboundLineId        String?               @db.Char(36)
  outboundLine          OutboundOrderLine?    @relation(fields: [organizationId, outboundLineId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// ISSUE only (WMS-28, ADR 0073): the material line of the production
  /// order it takes to the area; never changes.
  productionOrderLineId String?               @db.Char(36)
  productionOrderLine   ProductionOrderLine?  @relation(fields: [organizationId, productionOrderLineId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// PICK only: what the person confirmed they took (≤ quantity), and why
  /// it was less.
  pickedQuantity        Decimal?              @db.Decimal(12, 3)
  shortReason           String?               @db.VarChar(300)
  /// What it moves: a product (with its quantity and unit), or a whole
  /// container (WMS-53, ADR 0043; then no product, quantity, lot nor
  /// order). Exactly one of the two (CHECK); neither ever changes.
  productId             String?               @db.Char(36)
  product               Product?              @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  containerId           String?               @db.Char(36)
  container             Container?            @relation(fields: [organizationId, containerId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  fromLocationId        String                @db.Char(36)
  fromLocation          Location              @relation("TaskFrom", fields: [organizationId, fromLocationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  toLocationId          String                @db.Char(36)
  toLocation            Location              @relation("TaskTo", fields: [organizationId, toLocationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// PUTAWAY only (WMS-52, ADR 0042): where the goods were really left,
  /// written once by the delivery. `toLocationId` is the recommended place
  /// (the origin itself when there was none).
  placedLocationId      String?               @db.Char(36)
  placedLocation        Location?             @relation("TaskPlaced", fields: [organizationId, placedLocationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// The lot it moves, for a product by lot (WMS-21); never changes.
  lotId                 String?               @db.Char(36)
  lot                   Lot?                  @relation(fields: [organizationId, lotId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// In the product's unit (base), checked with its quantity rule; null
  /// for a container task.
  quantity              Decimal?              @db.Decimal(12, 3)
  unitCode              String?               @db.VarChar(12)
  /// Instructions for whoever does it.
  note                  String?               @db.VarChar(300)
  createdByUserId       String                @db.Char(36)
  createdAt             DateTime              @default(now()) @db.DateTime(3)
  /// Person who has it (assigned or who took it); null while pending.
  assignedToUserId      String?               @db.Char(36)
  acceptedAt            DateTime?             @db.DateTime(3)
  pickedUpAt            DateTime?             @db.DateTime(3)
  deliveredAt           DateTime?             @db.DateTime(3)
  blockedAt             DateTime?             @db.DateTime(3)
  blockedReason         String?               @db.VarChar(300)
  closedByUserId        String?               @db.Char(36)
  cancelledAt           DateTime?             @db.DateTime(3)
  cancelReason          String?               @db.VarChar(300)
  /// The transfer its delivery wrote.
  movementId            String?               @db.Char(36)
  movement              StockMovement?        @relation("TaskMovement", fields: [organizationId, movementId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// PICK only (WMS-54, ADR 0052): the entry (RECEIPT or ENTRY) whose goods
  /// it takes straight to its order (cross-docking); never changes.
  crossDockMovementId   String?               @db.Char(36)
  crossDockMovement     StockMovement?        @relation("TaskCrossDock", fields: [organizationId, crossDockMovementId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// WMS-42 (ADR 0065): the type of equipment it asks for (never changes)
  /// and the equipment whoever took it said they use (set when taking it,
  /// cleared when released; fixed once the task is closed).
  equipmentTypeId       String?               @db.Char(36)
  equipmentType         EquipmentType?        @relation(fields: [organizationId, equipmentTypeId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  equipmentId           String?               @db.Char(36)
  equipment             Equipment?            @relation(fields: [organizationId, equipmentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  updatedAt             DateTime              @updatedAt @db.DateTime(3)
  /// Units by serial the person took (WMS-21B): scanned when picking or
  /// picking up, moved by the delivery.
  serials               WarehouseTaskSerial[]
  incidents             Incident[]
  containerEvents       ContainerEvent[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@unique([organizationId, movementId])
  @@index([organizationId, containerId])
  @@index([organizationId, status, number])
  @@index([organizationId, assignedToUserId, status])
  @@index([organizationId, productId])
  @@index([organizationId, outboundLineId])
  @@index([organizationId, productionOrderLineId])
  @@index([organizationId, placedLocationId])
  @@index([organizationId, crossDockMovementId])
  @@index([organizationId, equipmentId, status])
  @@index([organizationId, equipmentTypeId])
  @@map("warehouse_task")
}

/// When a picking location gets filled again from storage (WMS-23, ADR
/// 0051): below `minQuantity` (what is free to pick there plus what open
/// REPLENISH tasks bring), tasks bring it up to `maxQuantity`, in
/// multiples of `multiple` when there is one. All in the product's unit.
/// One per product and location; neither ever changes (trigger).
model ReplenishmentRule {
  id              String       @id @db.Char(36)
  organizationId  String       @db.Char(36)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  productId       String       @db.Char(36)
  product         Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  locationId      String       @db.Char(36)
  location        Location     @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  minQuantity     Decimal      @db.Decimal(12, 3)
  maxQuantity     Decimal      @db.Decimal(12, 3)
  multiple        Decimal?     @db.Decimal(12, 3)
  /// People who created it and changed it last (accounts).
  createdByUserId String       @db.Char(36)
  updatedByUserId String       @db.Char(36)
  createdAt       DateTime     @default(now()) @db.DateTime(3)
  updatedAt       DateTime     @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, productId, locationId])
  @@index([organizationId, locationId])
  @@map("replenishment_rule")
}

// ── Estado y lote de las existencias (ADR 0033, WMS-10) ────────────────

/// State of stock, apart from where it physically is (spec 6.2). Reserved
/// is not a state: reservations subtract from AVAILABLE (WMS-12).
enum StockStatus {
  AVAILABLE
  RECEIVING
  INSPECTION
  QUARANTINE
  DAMAGED
  REJECTED
  IN_TRANSIT
  BLOCKED
  /// WMS-75 (ADR 0072): being repaired, refurbished or repacked; not
  /// available.
  REPAIR
}

/// A lot of a product (WMS-21, ADR 0040): its code — normalized, unique
/// per product — and, when it has one, its expiry date (a calendar day).
/// Product and code never change and a lot is never deleted (triggers);
/// the expiry date is corrected with `changeLotExpiry`, with audit.
model Lot {
  id                  String                 @id @db.Char(36)
  organizationId      String                 @db.Char(36)
  organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  productId           String                 @db.Char(36)
  product             Product                @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  code                String                 @db.VarChar(64)
  expiresOn           DateTime?              @db.Date
  createdByUserId     String                 @db.Char(36)
  createdAt           DateTime               @default(now()) @db.DateTime(3)
  balances            StockBalance[]
  lines               StockMovementLine[]
  reservations        StockReservation[]
  holds               StockHold[]
  tasks               WarehouseTask[]
  countLines          StockCountLine[]
  receiptLines        PurchaseReceiptLine[]
  exitImportRows      ExitImportRow[]
  containerItems      ContainerItem[]
  containerEvents     ContainerEvent[]
  packShortages       OutboundPackShortage[]
  shipmentLines       ShipmentLine[]
  customerReturnLines CustomerReturnLine[]
  transferLines       FacilityTransferLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, productId, code])
  /// The list of lots about to expire reads by date.
  @@index([organizationId, expiresOn])
  @@map("lot")
}

// ── Números de serie (WMS-21B, ADR 0041) ───────────────────────────────

/// One unit of a product controlled by serial number: its serial —
/// normalized like a lot code, unique per product in the company — and
/// where it is now (location and state) or null while it is out of the
/// warehouse. Only the trigger of `serial_move` changes where it is, so
/// it always follows its moves; product and serial never change and a
/// unit is never deleted (triggers). Units inside a location and state
/// add up to the balance of that product there (reconciliation).
model SerialUnit {
  id              String                @id @db.Char(36)
  organizationId  String                @db.Char(36)
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  productId       String                @db.Char(36)
  product         Product               @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  serial          String                @db.VarChar(64)
  /// Where it is; null = out of the warehouse (it left, or not yet in).
  locationId      String?               @db.Char(36)
  location        Location?             @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  status          StockStatus?
  /// The container it is packed in (WMS-53, ADR 0043); null = loose. It
  /// enters one only where the container is, available (trigger).
  containerId     String?               @db.Char(36)
  container       Container?            @relation(fields: [organizationId, containerId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdByUserId String                @db.Char(36)
  createdAt       DateTime              @default(now()) @db.DateTime(3)
  moves           SerialMove[]
  tasks           WarehouseTaskSerial[]
  holds           StockHoldUnit[]

  @@unique([organizationId, id])
  @@unique([organizationId, productId, serial])
  @@index([organizationId, productId, locationId, status])
  /// Traceability looks a serial up across products.
  @@index([organizationId, serial])
  @@index([organizationId, containerId])
  @@map("serial_unit")
}

/// Which unit a movement line moved (WMS-21B): one row per unit and line.
/// Written right before its line, in the same transaction; the trigger of
/// `stock_movement_line` checks that a line of a product by serial has
/// exactly one per unit it moves, all with its product, location, state
/// and direction, and the trigger of this table moves the unit (out of
/// where it is, or into the line's location). Never changes nor is
/// deleted. `movementLineId` has no foreign key: the line is inserted
/// after its rows.
model SerialMove {
  id             String         @id @db.Char(36)
  organizationId String         @db.Char(36)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  serialUnitId   String         @db.Char(36)
  serialUnit     SerialUnit     @relation(fields: [organizationId, serialUnitId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  movementLineId String         @db.Char(36)
  productId      String         @db.Char(36)
  locationId     String         @db.Char(36)
  location       Location       @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  status         StockStatus
  direction      StockDirection
  createdAt      DateTime       @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, movementLineId, serialUnitId])
  @@index([organizationId, serialUnitId, id])
  @@map("serial_move")
}

/// Units by serial a warehouse task took (WMS-21B): scanned when the
/// person confirms a pick or picks up a transfer; its delivery moves
/// exactly these. While the task is open nobody else takes them.
model WarehouseTaskSerial {
  id             String        @id @db.Char(36)
  organizationId String        @db.Char(36)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  taskId         String        @db.Char(36)
  task           WarehouseTask @relation(fields: [organizationId, taskId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  serialUnitId   String        @db.Char(36)
  serialUnit     SerialUnit    @relation(fields: [organizationId, serialUnitId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdAt      DateTime      @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, taskId, serialUnitId])
  @@index([organizationId, serialUnitId])
  @@map("warehouse_task_serial")
}

// ── Reservas (WMS-12, ADR 0033) ─────────────────────────────────────────

enum StockReservationState {
  /// Still holding stock.
  ACTIVE
  /// Nothing left: consumed by its document, released, or both.
  CLOSED
}

/// Stock set aside for a document (an outbound order, a production order)
/// without moving it (spec 5.2). It subtracts from AVAILABLE: of its
/// location when it names one, and of the product always. `quantity` never
/// changes; `remaining` only goes down (consumed or released) and the
/// reservation closes at zero (triggers).
model StockReservation {
  id              String                @id @db.Char(36)
  organizationId  String                @db.Char(36)
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  productId       String                @db.Char(36)
  product         Product               @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Null = any location of the product.
  locationId      String?               @db.Char(36)
  location        Location?             @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  lotId           String?               @db.Char(36)
  lot             Lot?                  @relation(fields: [organizationId, lotId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// In the product's unit.
  quantity        Decimal               @db.Decimal(12, 3)
  remaining       Decimal               @db.Decimal(12, 3)
  state           StockReservationState @default(ACTIVE)
  /// The document holding it: «outbound_order_line», «test»…
  sourceType      String                @db.VarChar(40)
  sourceId        String                @db.Char(36)
  createdByUserId String                @db.Char(36)
  createdAt       DateTime              @default(now()) @db.DateTime(3)
  closedAt        DateTime?             @db.DateTime(3)

  @@unique([organizationId, id])
  @@index([organizationId, productId, state])
  @@index([organizationId, sourceType, sourceId])
  @@map("stock_reservation")
}

/// What an open document holds of stock that is NOT available (WMS-30-0,
/// ADR 0068): while it is active, no change of state, reversal, disposal
/// or return to the supplier takes it. Written only by `holdStock` and
/// `releaseHold` (holds.ts), inside the document's transaction and after
/// its locks. `quantity` never changes; `remaining` only goes down; it is
/// never deleted (triggers).
model StockHold {
  id              String                @id @db.Char(36)
  organizationId  String                @db.Char(36)
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  productId       String                @db.Char(36)
  product         Product               @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  locationId      String                @db.Char(36)
  location        Location              @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Only INSPECTION, QUARANTINE, DAMAGED, REJECTED or BLOCKED (CHECK):
  /// what is available is reserved, not held.
  status          StockStatus
  lotId           String?               @db.Char(36)
  lot             Lot?                  @relation(fields: [organizationId, lotId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// COALESCE(lotId, ''), as in the balance (CHECK).
  lotKey          String                @default("") @db.Char(36)
  /// In the product's unit.
  quantity        Decimal               @db.Decimal(12, 3)
  remaining       Decimal               @db.Decimal(12, 3)
  state           StockReservationState @default(ACTIVE)
  /// The document holding it: «quality_inspection», «test»…
  sourceType      String                @db.VarChar(40)
  sourceId        String                @db.Char(36)
  /// «IN-0003»: how people see the document.
  sourceText      String                @db.VarChar(40)
  createdByUserId String                @db.Char(36)
  createdAt       DateTime              @default(now()) @db.DateTime(3)
  closedAt        DateTime?             @db.DateTime(3)
  units           StockHoldUnit[]

  @@unique([organizationId, id])
  @@index([organizationId, productId, locationId, state])
  @@index([organizationId, sourceType, sourceId])
  @@map("stock_hold")
}

/// The units by serial a hold keeps (WMS-30-0). `releasedAt` is written
/// once; never deleted (triggers).
model StockHoldUnit {
  id             String       @id @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  holdId         String       @db.Char(36)
  hold           StockHold    @relation(fields: [organizationId, holdId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  serialUnitId   String       @db.Char(36)
  serialUnit     SerialUnit   @relation(fields: [organizationId, serialUnitId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  releasedAt     DateTime?    @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, holdId, serialUnitId])
  @@index([organizationId, serialUnitId])
  @@map("stock_hold_unit")
}

// ── Pedidos de salida (WMS-13, especificación 5.2) ──────────────────────

/// Where an outbound order is (WMS-13). The only transitions are those of
/// `OUTBOUND_ORDER_TRANSITIONS` (outbound-states.ts), repeated by the
/// trigger `outbound_order_transition`.
enum OutboundOrderStatus {
  /// Being written: lines change freely, nothing is reserved.
  DRAFT
  /// Released to the warehouse: its stock is reserved.
  RELEASED
  /// Being picked (WMS-14).
  PICKING
  /// Picked, waiting to be packed (WMS-15).
  PICKED
  /// Being verified and packed into its packages (WMS-15, ADR 0044).
  PACKING
  /// Packed, waiting to leave (WMS-15).
  PACKED
  /// Left the warehouse: its exit was written (WMS-16).
  SHIPPED
  /// Cancelled with a reason; its reservations were released.
  CANCELLED
}

/// An order of goods to send out (spec 5.2): a warehouse document, without
/// prices, cash or charges (ADR 0032). Released, it reserves its stock
/// (WMS-12); picking, packing and shipping come in WMS-14..16.
model OutboundOrder {
  id                String                 @id @db.Char(36)
  organizationId    String                 @db.Char(36)
  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Consecutive per company («PS-0001»).
  number            Int
  status            OutboundOrderStatus    @default(DRAFT)
  priority          WarehouseTaskPriority  @default(NORMAL)
  /// Who receives it: a customer, a branch, a production line…
  recipient         String                 @db.VarChar(160)
  address           String?                @db.VarChar(300)
  /// The customer's own reference (their order number).
  reference         String?                @db.VarChar(120)
  /// Day it should leave (a calendar day of the company).
  dueOn             DateTime?              @db.Date
  note              String?                @db.VarChar(500)
  createdByUserId   String                 @db.Char(36)
  createdAt         DateTime               @default(now()) @db.DateTime(3)
  releasedAt        DateTime?              @db.DateTime(3)
  releasedByUserId  String?                @db.Char(36)
  cancelledAt       DateTime?              @db.DateTime(3)
  cancelledByUserId String?                @db.Char(36)
  cancelReason      String?                @db.VarChar(300)
  updatedAt         DateTime               @updatedAt @db.DateTime(3)
  lines             OutboundOrderLine[]
  /// The warehouse it leaves from (WMS-18): it is picked there.
  facilityId        String                 @db.Char(36)
  facility          Facility               @relation(fields: [organizationId, facilityId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Its packages (WMS-15, ADR 0044): containers with purpose PACKING.
  packages          Container[]
  /// What was missing when packing, with its reason (WMS-15).
  packShortages     OutboundPackShortage[]
  /// The embarques it was put in (WMS-16); at most one open.
  shipments         ShipmentOrder[]
  customerReturns   CustomerReturn[]
  incidents         Incident[]
  /// What left with its shipment (WMS-16).
  shipmentLines     ShipmentLine[]
  /// The picking waves it was put in (WMS-25); at most one open.
  waves             PickWaveOrder[]
  /// The file it came from (WMS-13B); null when written by hand.
  importId          String?                @db.Char(36)
  import            OutboundImport?        @relation(fields: [organizationId, importId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Imported orders only: its «Pedido» of the file, folded. Unique in the
  /// company, so the same order of a file never becomes two (WMS-13B).
  sourceKey         String?                @db.VarChar(80)
  /// WMS-60: sha256 (hex) of the API key and its Idempotency-Key: an order
  /// created by the API is not created twice. Apart from sourceKey, so a
  /// file can never take it nor the other way round.
  apiRequestKey     String?                @db.Char(64)

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@unique([organizationId, sourceKey])
  @@unique([organizationId, apiRequestKey])
  @@index([organizationId, status, number])
  @@map("outbound_order")
}

/// A parameter of how a company works (WMS-49): a key of the registry in
/// code (`@/platform/settings`) and its value as text, checked by the
/// definition when written and when read. No row = the default value.
model OrganizationSetting {
  id              String       @id @db.Char(36)
  organizationId  String       @db.Char(36)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  key             String       @db.VarChar(80)
  value           String       @db.VarChar(500)
  updatedByUserId String       @db.Char(36)
  createdAt       DateTime     @default(now()) @db.DateTime(3)
  updatedAt       DateTime     @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, key])
  @@map("organization_setting")
}

/// What a custom field belongs to (WMS-58, ADR 0056). A new entity is a
/// value here, a reference column in `custom_field_value` with its
/// composite key, and its line in the CHECK `custom_field_value_owner`.
enum CustomFieldEntity {
  PRODUCT
  LOCATION
  SUPPLIER
}

/// What a custom field holds; it never changes once created (trigger).
enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  CHOICE
  BOOLEAN
}

/// A field a company adds to its products, locations or suppliers
/// (WMS-58, ADR 0056): no column per customer, a row per field. It is
/// never deleted: it is archived, and its values stay.
model CustomField {
  id              String              @id @db.Char(36)
  organizationId  String              @db.Char(36)
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  entity          CustomFieldEntity
  /// Stable internal name, made from the first label («color_de_tapa»);
  /// it is what forms, filters and files carry. Never changes (trigger).
  key             String              @db.VarChar(40)
  /// What people read; may be renamed. Unique among the fields of the
  /// entity, without capitals or accents (the collation compares so).
  label           String              @db.VarChar(60)
  type            CustomFieldType
  /// Asked when a record is created or edited; old records are not touched.
  required        Boolean             @default(false)
  /// Order in forms, cards and files.
  position        Int
  archivedAt      DateTime?           @db.DateTime(3)
  createdByUserId String              @db.Char(36)
  createdAt       DateTime            @default(now()) @db.DateTime(3)
  updatedAt       DateTime            @updatedAt @db.DateTime(3)
  options         CustomFieldOption[]
  values          CustomFieldValue[]

  @@unique([organizationId, id])
  @@unique([organizationId, id, entity])
  @@unique([organizationId, entity, key])
  @@unique([organizationId, entity, label])
  @@map("custom_field")
}

/// An option of a «list» field. Renamed or archived, never deleted.
model CustomFieldOption {
  id             String             @id @db.Char(36)
  organizationId String             @db.Char(36)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fieldId        String             @db.Char(36)
  field          CustomField        @relation(fields: [organizationId, fieldId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  label          String             @db.VarChar(60)
  position       Int
  archivedAt     DateTime?          @db.DateTime(3)
  createdAt      DateTime           @default(now()) @db.DateTime(3)
  values         CustomFieldValue[]

  @@unique([organizationId, id])
  @@unique([organizationId, fieldId, id])
  @@unique([organizationId, fieldId, label])
  @@map("custom_field_option")
}

/// The value of one custom field for one record (WMS-58): one typed
/// column filled (CHECK), the record named by the reference column of its
/// entity with a composite key of the company (CHECK: exactly that one).
/// An empty value is no row.
model CustomFieldValue {
  id              String             @id @db.Char(36)
  organizationId  String             @db.Char(36)
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fieldId         String             @db.Char(36)
  /// Repeats the field's entity so the key below ties both together.
  entity          CustomFieldEntity
  field           CustomField        @relation(fields: [organizationId, fieldId, entity], references: [organizationId, id, entity], onDelete: Restrict, onUpdate: Restrict)
  productId       String?            @db.Char(36)
  product         Product?           @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  locationId      String?            @db.Char(36)
  location        Location?          @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  contactId       String?            @db.Char(36)
  contact         Contact?           @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  textValue       String?            @db.VarChar(200)
  numberValue     Decimal?           @db.Decimal(18, 6)
  dateValue       DateTime?          @db.Date
  /// An option of the same field (the key includes the field).
  optionId        String?            @db.Char(36)
  option          CustomFieldOption? @relation(fields: [organizationId, fieldId, optionId], references: [organizationId, fieldId, id], onDelete: Restrict, onUpdate: Restrict)
  boolValue       Boolean?
  updatedByUserId String             @db.Char(36)
  updatedAt       DateTime           @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, fieldId, productId])
  @@unique([organizationId, fieldId, locationId])
  @@unique([organizationId, fieldId, contactId])
  /// Filters of a list by a field (a list option, yes/no, exact text).
  @@index([organizationId, fieldId, optionId])
  @@index([organizationId, fieldId, boolValue])
  @@index([organizationId, fieldId, textValue])
  /// The values of a page of records, in one query.
  @@index([organizationId, productId])
  @@index([organizationId, locationId])
  @@index([organizationId, contactId])
  @@map("custom_field_value")
}

enum OutboundImportStatus {
  /// Uploaded: its rows are checked every time it is opened.
  READY
  /// Its orders were created, all of them in one transaction.
  CONFIRMED
  CANCELLED
}

/// A file of outbound orders (WMS-13B): one row per line. Confirming it
/// creates every draft at once, or none.
model OutboundImport {
  id                String               @id @db.Char(36)
  organizationId    String               @db.Char(36)
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fileId            String               @db.Char(36)
  file              StoredFile           @relation(fields: [organizationId, fileId], references: [organizationId, id], onDelete: Restrict)
  status            OutboundImportStatus @default(READY)
  /// "." or ",": how the person said decimals are written in the file.
  decimalSeparator  String               @db.Char(1)
  /// Rows with data under the titles.
  dataRows          Int
  /// Orders it created when confirmed.
  ordersCreated     Int                  @default(0)
  confirmedAt       DateTime?            @db.DateTime(3)
  confirmedByUserId String?              @db.Char(36)
  createdByUserId   String               @db.Char(36)
  createdAt         DateTime             @default(now()) @db.DateTime(3)
  updatedAt         DateTime             @updatedAt @db.DateTime(3)
  orders            OutboundOrder[]

  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@map("outbound_import")
}

/// What an outbound order asks for: one product per line, in its unit.
/// Lines only change while the order is a draft (trigger).
model OutboundOrderLine {
  id             String                 @id @db.Char(36)
  organizationId String                 @db.Char(36)
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  orderId        String                 @db.Char(36)
  order          OutboundOrder          @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  lineNumber     Int
  productId      String                 @db.Char(36)
  product        Product                @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// In the product's unit, checked with its quantity rule.
  quantity       Decimal                @db.Decimal(12, 3)
  unitCode       String                 @db.VarChar(12)
  createdAt      DateTime               @default(now()) @db.DateTime(3)
  /// Picking tasks of this line (WMS-14).
  tasks          WarehouseTask[]
  /// What was missing of this line when packing (WMS-15).
  packShortages  OutboundPackShortage[]
  /// What of this line left with its shipment (WMS-16).
  shipmentLines  ShipmentLine[]
  returnLines    CustomerReturnLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, orderId, lineNumber])
  @@unique([organizationId, orderId, productId])
  @@index([organizationId, productId])
  @@map("outbound_order_line")
}

// ── Tarimas y contenedores (WMS-53, ADR 0043) ───────────────────────────

/// What a container is for. Today only storage (a pallet, a box, a cage
/// that holds stock in a location); packing (WMS-15) adds its own value,
/// with the order it belongs to.
enum ContainerPurpose {
  STORAGE
  /// A package of an outbound order (WMS-15, ADR 0044): a box or pallet
  /// with what was verified of it, in the place where it waits to leave.
  PACKING
}

enum ContainerStatus {
  /// Holds stock, or may: it can be packed, moved, emptied.
  OPEN
  /// Taken apart: empty for good; it stays for its history.
  CLOSED
}

/// A pallet, a box or a cage with its own label (an LPN) in one location
/// (WMS-53, ADR 0043). It groups part of the stock of its location without
/// being part of the balance's key: what its items say is never more than
/// the balance (triggers on both sides, and the reconciliation). Moving it
/// moves exactly its items with one movement. Never deleted: closed.
model Container {
  id              String           @id @db.Char(36)
  organizationId  String           @db.Char(36)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Consecutive per company: «C-0001».
  number          Int
  /// What is scanned: «C-0001», or the label it already had (upper case).
  code            String           @db.VarChar(40)
  /// «Tarima», «Caja»… free text: it changes no rule.
  kind            String           @db.VarChar(40)
  purpose         ContainerPurpose @default(STORAGE)
  status          ContainerStatus  @default(OPEN)
  locationId      String           @db.Char(36)
  location        Location         @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdByUserId String           @db.Char(36)
  createdAt       DateTime         @default(now()) @db.DateTime(3)
  closedAt        DateTime?        @db.DateTime(3)
  closedByUserId  String?          @db.Char(36)
  /// PACKING only (WMS-15): the order it belongs to; never changes.
  outboundOrderId String?          @db.Char(36)
  outboundOrder   OutboundOrder?   @relation(fields: [organizationId, outboundOrderId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// PACKING only: weight of the package in kilograms, optional.
  weightKg        Decimal?         @db.Decimal(12, 3)
  /// PACKING only: closed and ready to leave; it takes nothing more.
  sealedAt        DateTime?        @db.DateTime(3)
  sealedByUserId  String?          @db.Char(36)
  updatedAt       DateTime         @updatedAt @db.DateTime(3)
  items           ContainerItem[]
  events          ContainerEvent[]
  serialUnits     SerialUnit[]
  movements       StockMovement[]
  tasks           WarehouseTask[]
  /// What left inside it with a shipment (WMS-16).
  shipmentLines   ShipmentLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@unique([organizationId, code])
  @@index([organizationId, locationId, status])
  @@index([organizationId, status, number])
  @@index([organizationId, outboundOrderId])
  @@map("container")
}

/// What a container holds now: one row per product, state and lot, in the
/// location of its container. Deleted when it reaches zero (its history is
/// in `container_event`). The sum of the items of a key (product,
/// location, state, lot) never passes its balance (triggers).
model ContainerItem {
  id             String       @id @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  containerId    String       @db.Char(36)
  container      Container    @relation(fields: [organizationId, containerId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  productId      String       @db.Char(36)
  product        Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Always the location of its container (trigger).
  locationId     String       @db.Char(36)
  location       Location     @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  status         StockStatus  @default(AVAILABLE)
  lotId          String?      @db.Char(36)
  lot            Lot?         @relation(fields: [organizationId, lotId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// COALESCE(lotId, ''), like the balance.
  lotKey         String       @default("") @db.VarChar(36)
  /// In the product's unit; always more than zero.
  quantity       Decimal      @db.Decimal(18, 3)
  createdAt      DateTime     @default(now()) @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, containerId, productId, status, lotKey])
  /// What the containers of a key hold, summed by the triggers.
  @@index([organizationId, productId, locationId, status, lotKey])
  @@index([organizationId, locationId])
  @@map("container_item")
}

enum ContainerEventKind {
  CREATED
  PACKED
  UNPACKED
  MOVED
  CLOSED
  /// A package of an order closed to leave, with its kind and weight
  /// (WMS-15).
  SEALED
  /// A closed package opened again to change what it holds (WMS-15).
  REOPENED
  /// What a package held when it left with its shipment (WMS-16): one per
  /// item, with the movement of the dispatch.
  SHIPPED
}

/// The history of a container (WMS-53): created, what was put in and taken
/// out, where it moved (with its movement) and when it was taken apart.
/// Never changes nor is deleted (triggers).
model ContainerEvent {
  id              String             @id @db.Char(36)
  organizationId  String             @db.Char(36)
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  containerId     String             @db.Char(36)
  container       Container          @relation(fields: [organizationId, containerId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  kind            ContainerEventKind
  /// Where it happened (MOVED: where it arrived).
  locationId      String             @db.Char(36)
  location        Location           @relation("ContainerEventAt", fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// MOVED: where it left from.
  fromLocationId  String?            @db.Char(36)
  fromLocation    Location?          @relation("ContainerEventFrom", fields: [organizationId, fromLocationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// PACKED / UNPACKED: what, in the product's unit.
  productId       String?            @db.Char(36)
  product         Product?           @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  lotId           String?            @db.Char(36)
  lot             Lot?               @relation(fields: [organizationId, lotId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  quantity        Decimal?           @db.Decimal(18, 3)
  /// Serials of the units, «A1, A2», for a product by serial.
  serials         String?            @db.Text
  /// MOVED: the movement that moved its stock, and the task, if any.
  movementId      String?            @db.Char(36)
  movement        StockMovement?     @relation(fields: [organizationId, movementId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  taskId          String?            @db.Char(36)
  task            WarehouseTask?     @relation(fields: [organizationId, taskId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdByUserId String             @db.Char(36)
  createdAt       DateTime           @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  @@index([organizationId, containerId, id])
  @@map("container_event")
}

/// What was missing of an outbound order when packing it (WMS-15, ADR
/// 0044): of one line and lot, how much (in the product's unit), which
/// units by serial and why. Writing it released that much of the order's
/// reservation in the staging place: the stock stays there, loose, for an
/// adjustment or a count. Never changes nor is deleted (triggers).
model OutboundPackShortage {
  id              String            @id @db.Char(36)
  organizationId  String            @db.Char(36)
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  orderId         String            @db.Char(36)
  order           OutboundOrder     @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  lineId          String            @db.Char(36)
  line            OutboundOrderLine @relation(fields: [organizationId, lineId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  productId       String            @db.Char(36)
  product         Product           @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  lotId           String?           @db.Char(36)
  lot             Lot?              @relation(fields: [organizationId, lotId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Where it was expected (the staging place).
  locationId      String            @db.Char(36)
  location        Location          @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// In the product's unit; always more than zero.
  quantity        Decimal           @db.Decimal(12, 3)
  /// Serials of the missing units, «A1, A2», for a product by serial.
  serials         String?           @db.Text
  reason          String            @db.VarChar(300)
  createdByUserId String            @db.Char(36)
  createdAt       DateTime          @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  @@index([organizationId, orderId, id])
  @@index([organizationId, lineId])
  @@map("outbound_pack_shortage")
}

enum ShipmentStatus {
  /// Being put together: its orders and transport data change.
  DRAFT
  /// Left the warehouse: its exit was written; it never changes again.
  SHIPPED
  /// Dropped before leaving, with a reason; its orders were let go.
  CANCELLED
}

/// A shipment (WMS-16, ADR 0045): one or several outbound orders that
/// leave together from one warehouse, with who takes them. Confirming it
/// writes one exit (`SHIPMENT`, key `ship:<id>`), consumes what the orders
/// held in the staging place and ships them. Never deleted.
model Shipment {
  id                String          @id @db.Char(36)
  organizationId    String          @db.Char(36)
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Consecutive per company («EM-0001»).
  number            Int
  status            ShipmentStatus  @default(DRAFT)
  /// The warehouse it leaves from: its orders are of that warehouse.
  facilityId        String          @db.Char(36)
  facility          Facility        @relation(fields: [organizationId, facilityId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Free text: there is no list of carriers.
  carrier           String?         @db.VarChar(120)
  /// Guide or tracking number of the carrier.
  trackingNumber    String?         @db.VarChar(120)
  vehiclePlate      String?         @db.VarChar(20)
  /// Who takes it (driver or who picks it up).
  driverName        String?         @db.VarChar(160)
  note              String?         @db.VarChar(500)
  createdByUserId   String          @db.Char(36)
  createdAt         DateTime        @default(now()) @db.DateTime(3)
  shippedAt         DateTime?       @db.DateTime(3)
  shippedByUserId   String?         @db.Char(36)
  /// Its exit; null while a draft, or when nothing physical left.
  movementId        String?         @db.Char(36)
  movement          StockMovement?  @relation(fields: [organizationId, movementId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  cancelledAt       DateTime?       @db.DateTime(3)
  cancelledByUserId String?         @db.Char(36)
  cancelReason      String?         @db.VarChar(300)
  updatedAt         DateTime        @updatedAt @db.DateTime(3)
  orders            ShipmentOrder[]
  lines             ShipmentLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@unique([organizationId, movementId])
  @@index([organizationId, facilityId, status, number])
  @@index([organizationId, status, shippedAt])
  @@map("shipment")
}

/// An outbound order in a shipment (WMS-16). `openOrderId` is the order
/// while the shipment is not cancelled: unique in the company, so an order
/// is in one open shipment at most. Removed only while its shipment is a
/// draft (triggers).
model ShipmentOrder {
  id              String        @id @db.Char(36)
  organizationId  String        @db.Char(36)
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shipmentId      String        @db.Char(36)
  shipment        Shipment      @relation(fields: [organizationId, shipmentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  orderId         String        @db.Char(36)
  order           OutboundOrder @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  openOrderId     String?       @db.Char(36)
  createdByUserId String        @db.Char(36)
  createdAt       DateTime      @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, shipmentId, orderId])
  @@unique([organizationId, openOrderId])
  @@index([organizationId, orderId])
  @@map("shipment_order")
}

/// What left with a shipment (WMS-16): one per line of its exit, with the
/// order and line it was for, its lot, its units by serial and the package
/// it travelled in. Immutable.
model ShipmentLine {
  id             String            @id @db.Char(36)
  organizationId String            @db.Char(36)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shipmentId     String            @db.Char(36)
  shipment       Shipment          @relation(fields: [organizationId, shipmentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  orderId        String            @db.Char(36)
  order          OutboundOrder     @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  orderLineId    String            @db.Char(36)
  orderLine      OutboundOrderLine @relation(fields: [organizationId, orderLineId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  productId      String            @db.Char(36)
  product        Product           @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Where it left from (the staging place).
  locationId     String            @db.Char(36)
  location       Location          @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  lotId          String?           @db.Char(36)
  lot            Lot?              @relation(fields: [organizationId, lotId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// The package it travelled in; null when it left loose.
  containerId    String?           @db.Char(36)
  container      Container?        @relation(fields: [organizationId, containerId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// In the product's unit; always more than zero.
  quantity       Decimal           @db.Decimal(12, 3)
  unitCode       String            @db.VarChar(12)
  /// Serials of the units, «A1, A2», for a product by serial.
  serials        String?           @db.Text
  /// The line of the exit that took it out of stock.
  movementLineId String            @db.Char(36)
  movementLine   StockMovementLine @relation(fields: [organizationId, movementLineId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdAt      DateTime          @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, movementLineId])
  @@index([organizationId, shipmentId, id])
  @@index([organizationId, orderId])
  @@index([organizationId, orderLineId])
  @@index([organizationId, lotId])
  @@index([organizationId, containerId])
  @@map("shipment_line")
}

// ── Devoluciones de clientes (WMS-17, ADR 0046) ─────────────────────────

/// Where a customer return is (WMS-17). The only transition is RECEIVED →
/// RESOLVED (`CUSTOMER_RETURN_TRANSITIONS`, customer-return-states.ts),
/// repeated by the trigger `customer_return_transition`.
enum CustomerReturnStatus {
  /// Received: something of it is still in inspection.
  RECEIVED
  /// Every line was decided: available, damaged or rejected.
  RESOLVED
}

/// What a customer brought back (WMS-17, ADR 0046): a document of the
/// warehouse, without prices. Receiving it writes one entry
/// (`CUSTOMER_RETURN`) into inspection; each decision is a change of state
/// tied to it (`customer_return_decision`). Never deleted.
model CustomerReturn {
  id              String                   @id @db.Char(36)
  organizationId  String                   @db.Char(36)
  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Consecutive per company («DV-0001»).
  number          Int
  status          CustomerReturnStatus     @default(RECEIVED)
  /// The warehouse that received it.
  facilityId      String                   @db.Char(36)
  facility        Facility                 @relation(fields: [organizationId, facilityId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Where it entered, in inspection.
  locationId      String                   @db.Char(36)
  location        Location                 @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// The shipped order it comes back from; null = without an order.
  orderId         String?                  @db.Char(36)
  order           OutboundOrder?           @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Who brings it back (free text; with an order, its recipient).
  returnedBy      String                   @db.VarChar(160)
  reason          String                   @db.VarChar(300)
  note            String?                  @db.VarChar(500)
  /// Its entry into inspection.
  movementId      String                   @db.Char(36)
  movement        StockMovement            @relation(fields: [organizationId, movementId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Sent with the confirmation so that repeating it receives once.
  idempotencyKey  String                   @db.VarChar(64)
  createdByUserId String                   @db.Char(36)
  createdAt       DateTime                 @default(now()) @db.DateTime(3)
  resolvedAt      DateTime?                @db.DateTime(3)
  lines           CustomerReturnLine[]
  decisions       CustomerReturnDecision[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@unique([organizationId, movementId])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, facilityId, status, number])
  @@index([organizationId, orderId])
  @@map("customer_return")
}

/// One product (and lot) that came back, in the product's unit, with the
/// line of its entry and, with an order, the order line it left with.
/// Immutable.
model CustomerReturnLine {
  id             String                   @id @db.Char(36)
  organizationId String                   @db.Char(36)
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  returnId       String                   @db.Char(36)
  return         CustomerReturn           @relation(fields: [organizationId, returnId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  lineNumber     Int
  productId      String                   @db.Char(36)
  product        Product                  @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  lotId          String?                  @db.Char(36)
  lot            Lot?                     @relation(fields: [organizationId, lotId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// The order line it left with; null without an order.
  orderLineId    String?                  @db.Char(36)
  orderLine      OutboundOrderLine?       @relation(fields: [organizationId, orderLineId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  quantity       Decimal                  @db.Decimal(12, 3)
  unitCode       String                   @db.VarChar(12)
  /// «A1, A2», for a product by serial.
  serials        String?                  @db.Text
  /// The line of the entry (IN, in inspection).
  movementLineId String                   @db.Char(36)
  movementLine   StockMovementLine        @relation(fields: [organizationId, movementLineId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdAt      DateTime                 @default(now()) @db.DateTime(3)
  decisions      CustomerReturnDecision[]

  @@unique([organizationId, id])
  @@unique([organizationId, returnId, lineNumber])
  @@unique([organizationId, movementLineId])
  @@index([organizationId, orderLineId])
  @@index([organizationId, productId])
  @@index([organizationId, lotId])
  @@map("customer_return_line")
}

/// What someone decided about part of a line (WMS-17): available, damaged
/// or rejected, with who, why, where it went and the change of state that
/// did it. Immutable.
model CustomerReturnDecision {
  id              String             @id @db.Char(36)
  organizationId  String             @db.Char(36)
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  returnId        String             @db.Char(36)
  return          CustomerReturn     @relation(fields: [organizationId, returnId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  lineId          String             @db.Char(36)
  line            CustomerReturnLine @relation(fields: [organizationId, lineId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// AVAILABLE, DAMAGED or REJECTED (CHECK).
  outcome         StockStatus
  quantity        Decimal            @db.Decimal(12, 3)
  reason          String             @db.VarChar(500)
  /// Where it ended up.
  locationId      String             @db.Char(36)
  location        Location           @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// The change of state (STATUS_CHANGE) that did it.
  movementId      String             @db.Char(36)
  movement        StockMovement      @relation(fields: [organizationId, movementId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  decidedByUserId String             @db.Char(36)
  createdAt       DateTime           @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, movementId])
  @@index([organizationId, returnId, id])
  @@index([organizationId, lineId])
  @@map("customer_return_decision")
}

// ── Traslados entre almacenes (WMS-19, ADR 0048) ───────────────────────

enum FacilityTransferStatus {
  /// Being put together: nothing moved, nothing set aside.
  DRAFT
  /// Sent: what it carries is in transit at the destination.
  SENT
  /// Nothing of it is left in transit (received, lost or back).
  RECEIVED
  /// Cancelled while it was a draft.
  CANCELLED
}

enum FacilityTransferReceiptKind {
  /// Arrived at the destination (available or damaged).
  RECEIVED
  /// Lost on the way: written off from transit.
  LOST
  /// Came back to the warehouse it left from.
  RETURNED
}

/// Goods sent from one warehouse of the company to another (WMS-19, ADR
/// 0048). Sending writes one FACILITY_TRANSFER movement into the transit
/// location of the destination (IN_TRANSIT); each receipt, loss or return
/// takes out of it. Never deleted.
model FacilityTransfer {
  id                String                    @id @db.Char(36)
  organizationId    String                    @db.Char(36)
  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Consecutive per company («TR-0001»).
  number            Int
  status            FacilityTransferStatus    @default(DRAFT)
  fromFacilityId    String                    @db.Char(36)
  fromFacility      Facility                  @relation("TransferFrom", fields: [organizationId, fromFacilityId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  toFacilityId      String                    @db.Char(36)
  toFacility        Facility                  @relation("TransferTo", fields: [organizationId, toFacilityId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Where it waits in transit: the transit location of the destination.
  transitLocationId String                    @db.Char(36)
  transitLocation   Location                  @relation(fields: [organizationId, transitLocationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  note              String?                   @db.VarChar(500)
  /// Who takes it (free text), written when it is sent.
  carrier           String?                   @db.VarChar(160)
  /// Sent with the creation so that repeating it creates one draft.
  idempotencyKey    String                    @db.VarChar(64)
  createdByUserId   String                    @db.Char(36)
  createdAt         DateTime                  @default(now()) @db.DateTime(3)
  /// The movement of the send (FACILITY_TRANSFER).
  sendMovementId    String?                   @db.Char(36)
  sendMovement      StockMovement?            @relation(fields: [organizationId, sendMovementId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  sentByUserId      String?                   @db.Char(36)
  sentAt            DateTime?                 @db.DateTime(3)
  /// When nothing was left in transit.
  closedAt          DateTime?                 @db.DateTime(3)
  cancelledByUserId String?                   @db.Char(36)
  cancelledAt       DateTime?                 @db.DateTime(3)
  cancelReason      String?                   @db.VarChar(300)
  lines             FacilityTransferLine[]
  receipts          FacilityTransferReceipt[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, sendMovementId])
  @@index([organizationId, fromFacilityId, status, number])
  @@index([organizationId, toFacilityId, status, number])
  @@map("facility_transfer")
}

/// One product (location of origin and lot) a transfer carries, in the
/// product's unit. Added and removed only while the transfer is a draft;
/// its line into transit is written once, when it is sent.
model FacilityTransferLine {
  id             String                        @id @db.Char(36)
  organizationId String                        @db.Char(36)
  organization   Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  transferId     String                        @db.Char(36)
  transfer       FacilityTransfer              @relation(fields: [organizationId, transferId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  lineNumber     Int
  productId      String                        @db.Char(36)
  product        Product                       @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Where it leaves from, in the warehouse of origin.
  fromLocationId String                        @db.Char(36)
  fromLocation   Location                      @relation(fields: [organizationId, fromLocationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  lotId          String?                       @db.Char(36)
  lot            Lot?                          @relation(fields: [organizationId, lotId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  quantity       Decimal                       @db.Decimal(12, 3)
  unitCode       String                        @db.VarChar(12)
  /// «A1, A2», for a product by serial.
  serials        String?                       @db.Text
  /// Its line into transit (IN, IN_TRANSIT), once it was sent.
  transitLineId  String?                       @db.Char(36)
  transitLine    StockMovementLine?            @relation(fields: [organizationId, transitLineId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdAt      DateTime                      @default(now()) @db.DateTime(3)
  receiptLines   FacilityTransferReceiptLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, transferId, lineNumber])
  @@unique([organizationId, transitLineId])
  @@index([organizationId, productId])
  @@index([organizationId, lotId])
  @@map("facility_transfer_line")
}

/// One receipt, loss or return of what a transfer had in transit, with its
/// movement, who and why. Immutable.
model FacilityTransferReceipt {
  id              String                        @id @db.Char(36)
  organizationId  String                        @db.Char(36)
  organization    Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  transferId      String                        @db.Char(36)
  transfer        FacilityTransfer              @relation(fields: [organizationId, transferId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  kind            FacilityTransferReceiptKind
  /// Where it ended: the place it was received in or came back to; the
  /// transit location for a loss.
  locationId      String                        @db.Char(36)
  location        Location                      @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  movementId      String                        @db.Char(36)
  movement        StockMovement                 @relation(fields: [organizationId, movementId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  idempotencyKey  String                        @db.VarChar(64)
  /// Mandatory for a loss or a return; a note for a receipt.
  reason          String?                       @db.VarChar(500)
  createdByUserId String                        @db.Char(36)
  createdAt       DateTime                      @default(now()) @db.DateTime(3)
  lines           FacilityTransferReceiptLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, movementId])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, transferId, id])
  @@map("facility_transfer_receipt")
}

/// What one receipt settled of one line: how much, in what state it ended
/// (available or damaged; IN_TRANSIT for what was lost) and the line of
/// the movement that did it. Immutable; never more than what was sent.
model FacilityTransferReceiptLine {
  id             String                  @id @db.Char(36)
  organizationId String                  @db.Char(36)
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  receiptId      String                  @db.Char(36)
  receipt        FacilityTransferReceipt @relation(fields: [organizationId, receiptId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  lineId         String                  @db.Char(36)
  line           FacilityTransferLine    @relation(fields: [organizationId, lineId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  status         StockStatus
  quantity       Decimal                 @db.Decimal(12, 3)
  /// The line of the movement: IN where it ended, OUT for a loss.
  movementLineId String                  @db.Char(36)
  movementLine   StockMovementLine       @relation(fields: [organizationId, movementLineId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  serials        String?                 @db.Text
  createdAt      DateTime                @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, movementLineId])
  @@index([organizationId, lineId])
  @@index([organizationId, receiptId])
  @@map("facility_transfer_receipt_line")
}

enum ApprovalStatus {
  /// Waiting for someone who may decide.
  PENDING
  /// Authorized: the module applied it in the same transaction.
  APPROVED
  /// Refused, with a reason.
  REJECTED
  /// Withdrawn by who asked for it.
  CANCELLED
  /// No longer applies (the world changed); `outcome` says why.
  EXPIRED
}

/// What a company asks to authorize for one approval type (WMS-56, ADR
/// 0053). Without a row the type asks for nothing. It is configuration:
/// it changes, and every change goes to the audit log.
model ApprovalRule {
  id                String       @id @db.Char(36)
  organizationId    String       @db.Char(36)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// «inventory.adjustment»: the key of a registered approval type.
  typeKey           String       @db.VarChar(80)
  enabled           Boolean      @default(false)
  /// Roles of the matrix that may decide, separated by commas.
  approverRoles     String       @default("") @db.VarChar(200)
  /// Who asked may also decide (false by default: four eyes).
  allowSelfApproval Boolean      @default(false)
  updatedByUserId   String       @db.Char(36)
  createdAt         DateTime     @default(now()) @db.DateTime(3)
  updatedAt         DateTime     @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, typeKey])
  @@map("approval_rule")
}

/// One request to authorize something (WMS-56, ADR 0053). Fixed when it is
/// asked for; only its state and decision change, once (trigger), and it
/// is never deleted.
model ApprovalRequest {
  id                String         @id @db.Char(36)
  organizationId    String         @db.Char(36)
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  typeKey           String         @db.VarChar(80)
  /// What it is about: «stock_count» + its id; null when it is new.
  sourceType        String?        @db.VarChar(40)
  sourceId          String?        @db.Char(36)
  /// While pending: one open request per thing (unique); null after.
  openKey           String?        @db.VarChar(120)
  /// The confirmation of the form that asked for it: a retry finds it.
  idempotencyKey    String?        @db.VarChar(64)
  /// Warehouse and location it is about (scope, WMS-20).
  facilityId        String?        @db.Char(36)
  facility          Facility?      @relation(fields: [organizationId, facilityId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  locationId        String?        @db.Char(36)
  location          Location?      @relation(fields: [organizationId, facilityId, locationId], references: [organizationId, facilityId, id], onDelete: Restrict, onUpdate: Restrict)
  /// What the approver reads, fixed when asked (never with costs).
  summary           String         @db.VarChar(1000)
  /// What the module needs to apply it; it checks it again then.
  payload           Json
  status            ApprovalStatus @default(PENDING)
  requestedByUserId String         @db.Char(36)
  createdAt         DateTime       @default(now()) @db.DateTime(3)
  decidedByUserId   String?        @db.Char(36)
  decidedAt         DateTime?      @db.DateTime(3)
  decisionReason    String?        @db.VarChar(500)
  /// What happened: the module's sentence, or why it expired.
  outcome           String?        @db.VarChar(1000)

  @@unique([organizationId, id])
  @@unique([organizationId, openKey])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, createdAt, id])
  @@index([organizationId, requestedByUserId, createdAt, id])
  @@index([organizationId, sourceType, sourceId])
  @@map("approval_request")
}

/// States of a picking wave (WMS-25, ADR 0054).
enum PickWaveStatus {
  OPEN
  DONE
  CANCELLED
}

/// A picking wave (WMS-25, ADR 0054): outbound orders of a warehouse picked
/// together. It only groups, orders and shares out their PICK tasks: every
/// task stays of one line of one order. Ends by itself when none of its
/// picking tasks is open; cancelling it only ungroups. Never deleted.
model PickWave {
  id                String          @id @db.Char(36)
  organizationId    String          @db.Char(36)
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Consecutive per company («OL-0001»).
  number            Int
  status            PickWaveStatus  @default(OPEN)
  facilityId        String          @db.Char(36)
  facility          Facility        @relation(fields: [organizationId, facilityId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdByUserId   String          @db.Char(36)
  createdAt         DateTime        @default(now()) @db.DateTime(3)
  doneAt            DateTime?       @db.DateTime(3)
  cancelledAt       DateTime?       @db.DateTime(3)
  cancelledByUserId String?         @db.Char(36)
  cancelReason      String?         @db.VarChar(300)
  orders            PickWaveOrder[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([organizationId, facilityId, status, number])
  @@map("pick_wave")
}

/// An outbound order in a picking wave (WMS-25). `openOrderId` is the order
/// while the wave is open: unique in the company, so an order is in one
/// open wave at most. It only lets go of its order (triggers).
model PickWaveOrder {
  id             String        @id @db.Char(36)
  organizationId String        @db.Char(36)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  waveId         String        @db.Char(36)
  wave           PickWave      @relation(fields: [organizationId, waveId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  orderId        String        @db.Char(36)
  order          OutboundOrder @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  openOrderId    String?       @db.Char(36)
  createdAt      DateTime      @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, waveId, orderId])
  @@unique([organizationId, openOrderId])
  @@index([organizationId, orderId])
  @@map("pick_wave_order")
}

/// A notice for one person inside the app (WMS-39, ADR 0057). Written only
/// by `notify` of platform/notifications, inside the transaction of the
/// fact that causes it. Text and destination are fixed when created; only
/// `readAt` changes, once (trigger). Read notices older than 90 days are
/// removed by a round; unread ones stay.
model Notification {
  id              String       @id @db.Char(36)
  organizationId  String       @db.Char(36)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Who it is for: only that person sees it.
  recipientUserId String       @db.Char(36)
  /// «inventory.task_assigned»: the type declared by its module.
  typeKey         String       @db.VarChar(80)
  /// What happened, one line, never with costs.
  text            String       @db.VarChar(300)
  /// Internal path of the app it leads to («/tareas/…»).
  href            String       @db.VarChar(300)
  /// Same fact → same key: a person gets it once.
  dedupeKey       String       @db.VarChar(160)
  /// Who caused it (never notified about it); null = the system.
  actorUserId     String?      @db.Char(36)
  createdAt       DateTime     @default(now()) @db.DateTime(3)
  readAt          DateTime?    @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, recipientUserId, dedupeKey])
  @@index([organizationId, recipientUserId, readAt])
  @@index([organizationId, recipientUserId, createdAt, id])
  @@index([organizationId, readAt])
  @@map("notification")
}

/// A person turned a type of notice off (or on, if it is off by default)
/// (WMS-39). Without a row the type's default applies.
model NotificationPreference {
  id             String       @id @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId         String       @db.Char(36)
  typeKey        String       @db.VarChar(80)
  enabled        Boolean
  /// Also by mail (WMS-39B, ADR 0060). Off by default: only who asks.
  email          Boolean      @default(false)
  updatedAt      DateTime     @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, userId, typeKey])
  @@index([organizationId, typeKey, email])
  @@map("notification_preference")
}

/// How a notice by mail ended (WMS-39B, ADR 0060).
enum NotificationEmailStatus {
  QUEUED
  SENT
  SKIPPED
  FAILED
}

/// A notice that also goes out by mail (WMS-39B, ADR 0060). Written by
/// `notify` in the transaction of the fact; sent by the worker, grouped
/// per person. Text and destination are a copy of the notice: the notice
/// may be cleaned up before this row is.
model NotificationEmail {
  id              String                  @id @db.Char(36)
  organizationId  String                  @db.Char(36)
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// The notice it repeats (no relation: notices are cleaned up).
  notificationId  String                  @db.Char(36)
  recipientUserId String                  @db.Char(36)
  typeKey         String                  @db.VarChar(80)
  text            String                  @db.VarChar(300)
  href            String                  @db.VarChar(300)
  /// What receiving it required (permissions, match, facility or
  /// location): checked again before it is sent.
  requirement     Json
  status          NotificationEmailStatus @default(QUEUED)
  /// Job that took it to send; null while it waits.
  claimedBy       String?                 @db.Char(36)
  /// Why it did not go out (SKIPPED, FAILED).
  reason          String?                 @db.VarChar(300)
  createdAt       DateTime                @default(now()) @db.DateTime(3)
  sentAt          DateTime?               @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, notificationId])
  @@index([organizationId, recipientUserId, status, claimedBy])
  @@index([organizationId, recipientUserId, sentAt])
  @@index([organizationId, status, createdAt])
  @@map("notification_email")
}

/// How the daily summary of a person ended (WMS-39B, ADR 0060).
enum DailyDigestStatus {
  QUEUED
  SENT
  EMPTY
  SKIPPED
  FAILED
}

/// The daily summary by mail of one person for one day of the company's
/// calendar (WMS-39B, ADR 0060): lots about to expire and low stock. One
/// per person and day; the round that sets it aside never makes two.
model DailyDigest {
  id             String            @id @db.Char(36)
  organizationId String            @db.Char(36)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId         String            @db.Char(36)
  /// Day of the company's calendar.
  day            DateTime          @db.Date
  status         DailyDigestStatus @default(QUEUED)
  reason         String?           @db.VarChar(300)
  createdAt      DateTime          @default(now()) @db.DateTime(3)
  sentAt         DateTime?         @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, userId, day])
  @@index([organizationId, createdAt])
  @@map("daily_digest")
}

/// What kind of problem an incident is (WMS-39): a fixed, generic list.
enum IncidentKind {
  DAMAGED_GOODS
  MISPLACED
  UNSAFE_LOCATION
  BROKEN_EQUIPMENT
  OTHER
}

/// States of an incident (WMS-39, ADR 0057).
enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

/// A problem of the warehouse that someone reported (WMS-39, ADR 0057):
/// damaged goods found, something out of place, an unsafe location, broken
/// equipment. It never changes stock. What was reported does not change;
/// states with INCIDENT_TRANSITIONS and the trigger `incident_transition`.
/// Never deleted.
model Incident {
  id               String          @id @db.Char(36)
  organizationId   String          @db.Char(36)
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Consecutive per company («INC-0001»).
  number           Int
  facilityId       String          @db.Char(36)
  facility         Facility        @relation(fields: [organizationId, facilityId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  kind             IncidentKind
  status           IncidentStatus  @default(OPEN)
  description      String          @db.VarChar(1000)
  /// What it is about, all optional; the location is of its warehouse.
  locationId       String?         @db.Char(36)
  location         Location?       @relation(fields: [organizationId, facilityId, locationId], references: [organizationId, facilityId, id], onDelete: Restrict, onUpdate: Restrict)
  productId        String?         @db.Char(36)
  product          Product?        @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  taskId           String?         @db.Char(36)
  task             WarehouseTask?  @relation(fields: [organizationId, taskId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  outboundOrderId  String?         @db.Char(36)
  outboundOrder    OutboundOrder?  @relation(fields: [organizationId, outboundOrderId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// The equipment it is about (WMS-42), of its warehouse.
  equipmentId      String?         @db.Char(36)
  equipment        Equipment?      @relation(fields: [organizationId, facilityId, equipmentId], references: [organizationId, facilityId, id], onDelete: Restrict, onUpdate: Restrict)
  /// The confirmation of the form: a retry finds the same incident.
  idempotencyKey   String          @db.VarChar(64)
  reportedByUserId String          @db.Char(36)
  createdAt        DateTime        @default(now()) @db.DateTime(3)
  /// Who took it («en atención») and when.
  attendedByUserId String?         @db.Char(36)
  attendedAt       DateTime?       @db.DateTime(3)
  /// Resolved (what was done) or dismissed (why).
  closedByUserId   String?         @db.Char(36)
  closedAt         DateTime?       @db.DateTime(3)
  resolution       String?         @db.VarChar(500)
  updatedAt        DateTime        @updatedAt @db.DateTime(3)
  notes            IncidentNote[]
  evidencePhotos   EvidencePhoto[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, facilityId, status, number])
  @@index([organizationId, reportedByUserId, number])
  @@index([organizationId, locationId])
  @@index([organizationId, productId])
  @@index([organizationId, taskId])
  @@index([organizationId, outboundOrderId])
  @@index([organizationId, equipmentId, number])
  @@map("incident")
}

/// A follow-up note of an incident (WMS-39): never changed or deleted.
model IncidentNote {
  id              String          @id @db.Char(36)
  organizationId  String          @db.Char(36)
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  incidentId      String          @db.Char(36)
  incident        Incident        @relation(fields: [organizationId, incidentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  text            String          @db.VarChar(1000)
  createdByUserId String          @db.Char(36)
  createdAt       DateTime        @default(now()) @db.DateTime(3)
  evidencePhotos  EvidencePhoto[]

  @@unique([organizationId, id])
  @@index([organizationId, incidentId, createdAt, id])
  @@map("incident_note")
}

/// A photo linked as evidence to a record (WMS-37, ADR 0063). One reference
/// column per kind of record, with composite keys; a CHECK demands exactly
/// one owner (a step that adds a kind adds its column and widens the
/// CHECK). Never changes nor is deleted, and its file can no longer be
/// removed (triggers).
model EvidencePhoto {
  id              String        @id @db.Char(36)
  organizationId  String        @db.Char(36)
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fileId          String        @db.Char(36)
  file            StoredFile    @relation(fields: [organizationId, fileId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// The purpose of its file (FILE_PURPOSES); a trigger checks they match.
  purpose         String        @db.VarChar(40)
  incidentId      String?       @db.Char(36)
  incident        Incident?     @relation(fields: [organizationId, incidentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// The follow-up note it came with, if any (of the same incident).
  incidentNoteId  String?       @db.Char(36)
  incidentNote    IncidentNote? @relation(fields: [organizationId, incidentNoteId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// A step of a process (WMS-74, ADR 0069).
  processStepId   String?       @db.Char(36)
  processStep     ProcessStep?  @relation(fields: [organizationId, processStepId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Order inside its owner (0, 1, 2…).
  position        Int
  createdByUserId String        @db.Char(36)
  createdAt       DateTime      @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, fileId])
  @@index([organizationId, incidentId, position])
  @@index([organizationId, incidentNoteId])
  @@index([organizationId, processStepId, position])
  @@map("evidence_photo")
}

// ── Equipos del almacén (WMS-42, ADR 0065) ─────────────────────────────

/// A type of equipment, named by each company («Montacargas», «Patín
/// eléctrico»…). Never deleted: archived, it is no longer offered.
model EquipmentType {
  id              String          @id @db.Char(36)
  organizationId  String          @db.Char(36)
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Unique in the company without case or accents (the collation).
  name            String          @db.VarChar(60)
  archivedAt      DateTime?       @db.DateTime(3)
  createdByUserId String          @db.Char(36)
  createdAt       DateTime        @default(now()) @db.DateTime(3)
  updatedAt       DateTime        @updatedAt @db.DateTime(3)
  equipment       Equipment[]
  tasks           WarehouseTask[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@map("equipment_type")
}

enum EquipmentStatus {
  IN_SERVICE
  OUT_OF_SERVICE
}

/// A piece of equipment of a warehouse (WMS-42): what is scanned is its
/// code, unique in the company. Never deleted: retired (`retiredAt`).
model Equipment {
  id                   String                 @id @db.Char(36)
  organizationId       String                 @db.Char(36)
  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  facilityId           String                 @db.Char(36)
  facility             Facility               @relation(fields: [organizationId, facilityId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  typeId               String                 @db.Char(36)
  type                 EquipmentType          @relation(fields: [organizationId, typeId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// «MC-01»: upper case, what its label says.
  code                 String                 @db.VarChar(30)
  name                 String                 @db.VarChar(120)
  status               EquipmentStatus        @default(IN_SERVICE)
  /// Why, who and when it went out of service (while OUT_OF_SERVICE).
  outOfServiceReason   String?                @db.VarChar(300)
  outOfServiceAt       DateTime?              @db.DateTime(3)
  outOfServiceByUserId String?                @db.Char(36)
  /// The next maintenance, a day of the company's calendar.
  maintenanceDueOn     DateTime?              @db.Date
  /// Retired: no longer used nor offered; kept for the trace.
  retiredAt            DateTime?              @db.DateTime(3)
  retiredReason        String?                @db.VarChar(300)
  retiredByUserId      String?                @db.Char(36)
  createdByUserId      String                 @db.Char(36)
  createdAt            DateTime               @default(now()) @db.DateTime(3)
  updatedAt            DateTime               @updatedAt @db.DateTime(3)
  maintenance          EquipmentMaintenance[]
  tasks                WarehouseTask[]
  incidents            Incident[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@unique([organizationId, facilityId, id])
  @@index([organizationId, facilityId, retiredAt, code])
  @@index([organizationId, typeId])
  @@index([organizationId, maintenanceDueOn])
  @@map("equipment")
}

/// A maintenance done to a piece of equipment (WMS-42): never changed or
/// deleted (trigger).
model EquipmentMaintenance {
  id               String       @id @db.Char(36)
  organizationId   String       @db.Char(36)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  equipmentId      String       @db.Char(36)
  equipment        Equipment    @relation(fields: [organizationId, equipmentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// The day it was done (company calendar).
  performedOn      DateTime     @db.Date
  description      String       @db.VarChar(500)
  /// Who did it when it was not the person recording it (a workshop).
  performedBy      String?      @db.VarChar(120)
  /// The next maintenance it set, if any.
  nextDueOn        DateTime?    @db.Date
  /// The confirmation of the form: a retry finds the same record.
  idempotencyKey   String?      @db.VarChar(64)
  recordedByUserId String       @db.Char(36)
  createdAt        DateTime     @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, equipmentId, performedOn, id])
  @@map("equipment_maintenance")
}

/// A device registered as a shared terminal of a warehouse (WMS-38,
/// ADR 0061). The device keeps a random secret in an HttpOnly cookie; only
/// its SHA-256 is stored (SharedTerminalSecret). Never deleted: removing it marks `removedAt`,
/// which makes the secret useless and closes its sessions.
model SharedTerminal {
  id              String                 @id @db.Char(36)
  organizationId  String                 @db.Char(36)
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  facilityId      String                 @db.Char(36)
  facility        Facility               @relation(fields: [organizationId, facilityId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  name            String                 @db.VarChar(60)
  createdByUserId String                 @db.Char(36)
  createdAt       DateTime               @default(now()) @db.DateTime(3)
  lastUsedAt      DateTime?              @db.DateTime(3)
  removedAt       DateTime?              @db.DateTime(3)
  /// Null when the system removed it (a copied cookie was used).
  removedByUserId String?                @db.Char(36)
  updatedAt       DateTime               @updatedAt @db.DateTime(3)
  secrets         SharedTerminalSecret[]

  @@unique([organizationId, id])
  @@index([organizationId, removedAt, name])
  @@index([organizationId, facilityId])
  @@map("shared_terminal")
}

/// Every secret given to a shared terminal (WMS-38, ADR 0061 §1): only its
/// SHA-256. The newest is the current one; an older one keeps working
/// while no newer one has been presented (a lost answer breaks nothing),
/// and presented after a newer one was (beyond a short grace) it means two
/// devices: the terminal is removed. Only `presentedAt` changes, once.
/// Rows older than 30 days are cleaned up when the terminal rotates.
model SharedTerminalSecret {
  id             String         @id @db.Char(36)
  organizationId String         @db.Char(36)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  terminalId     String         @db.Char(36)
  terminal       SharedTerminal @relation(fields: [organizationId, terminalId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  secretHash     String         @unique @db.Char(64)
  issuedAt       DateTime       @db.DateTime(3)
  /// First time a request brought it (the device really has it).
  presentedAt    DateTime?      @db.DateTime(3)

  @@unique([organizationId, id])
  @@index([organizationId, terminalId, issuedAt])
  @@map("shared_terminal_secret")
}

/// The PIN of a person in a company (WMS-38, ADR 0061): scrypt over an
/// HMAC of the PIN with the server secret, the company and the person.
/// Never stored or logged in clear. Deleted when removed or when the
/// person is disabled.
model MemberPin {
  id             String       @id @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId         String       @db.Char(36)
  pinHash        String       @db.VarChar(255)
  setAt          DateTime     @db.DateTime(3)
  createdAt      DateTime     @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, userId])
  @@map("member_pin")
}

/// A key of the API of a company (WMS-60, ADR 0058). It acts for the
/// person who created it, cut down to its capabilities and, if limited, to
/// its warehouse. Only the hash of the secret is kept. Never deleted:
/// revoked.
model ApiKey {
  id                String       @id @db.Char(36)
  organizationId    String       @db.Char(36)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// «ERP», «Tienda»: how people recognize it.
  name              String       @db.VarChar(80)
  /// Visible part of the key («wms_ab12cd34»).
  prefix            String       @db.VarChar(16)
  /// sha256 of the whole key, hex: how a call finds it.
  secretHash        String       @unique @db.Char(64)
  /// Capabilities of version 1 («stock.read»).
  capabilities      Json
  /// Warehouse it works in (lists and new documents).
  facilityId        String       @db.Char(36)
  facility          Facility     @relation(fields: [organizationId, facilityId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// True: it reaches only that warehouse.
  facilityOnly      Boolean      @default(false)
  /// Calls per minute of this key; never more than the company.
  requestsPerMinute Int
  expiresAt         DateTime?    @db.DateTime(3)
  lastUsedAt        DateTime?    @db.DateTime(3)
  createdByUserId   String       @db.Char(36)
  createdAt         DateTime     @default(now()) @db.DateTime(3)
  revokedAt         DateTime?    @db.DateTime(3)
  revokedByUserId   String?      @db.Char(36)
  updatedAt         DateTime     @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, prefix])
  @@index([organizationId, revokedAt, createdAt])
  @@index([organizationId, facilityId])
  @@map("api_key")
}

/// Fixed one-minute window of calls of a key or of a company (WMS-60).
/// One row per counter, reused in each window; not a company table: the
/// key says whose it is («api:key:<id>», «api:org:<id>»).
model ApiRateWindow {
  key         String   @id @db.VarChar(80)
  windowStart DateTime @db.DateTime(3)
  count       Int

  @@map("api_rate_window")
}

enum WebhookEndpointStatus {
  ACTIVE
  PAUSED
}

/// Where a company wants its events (WMS-60). The signing secret is kept
/// encrypted (it must be usable to sign); the previous one lives 24 hours
/// after a change.
model WebhookEndpoint {
  id                       String                @id @db.Char(36)
  organizationId           String                @db.Char(36)
  organization             Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  url                      String                @db.VarChar(500)
  description              String?               @db.VarChar(120)
  /// Keys of the event types it receives.
  events                   Json
  status                   WebhookEndpointStatus @default(ACTIVE)
  /// True when it paused itself after repeated failures.
  pausedByFailures         Boolean               @default(false)
  consecutiveFailures      Int                   @default(0)
  secretCiphertext         String                @db.VarChar(255)
  previousSecretCiphertext String?               @db.VarChar(255)
  previousSecretExpiresAt  DateTime?             @db.DateTime(3)
  createdByUserId          String                @db.Char(36)
  createdAt                DateTime              @default(now()) @db.DateTime(3)
  updatedAt                DateTime              @updatedAt @db.DateTime(3)
  /// Removed: kept for its deliveries, receives nothing.
  removedAt                DateTime?             @db.DateTime(3)
  deliveries               WebhookDelivery[]

  @@unique([organizationId, id])
  @@index([organizationId, removedAt, createdAt])
  @@map("webhook_endpoint")
}

/// A fact sent to webhooks (WMS-60); its id is the same in every attempt.
model WebhookEvent {
  id             String            @id @db.Char(36)
  organizationId String            @db.Char(36)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  type           String            @db.VarChar(80)
  /// The whole body sent, already without costs.
  payload        Json
  createdAt      DateTime          @default(now()) @db.DateTime(3)
  deliveries     WebhookDelivery[]

  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@map("webhook_event")
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  SKIPPED
}

/// One event to one destination (WMS-60): what people see of each attempt.
model WebhookDelivery {
  id             String                @id @db.Char(36)
  organizationId String                @db.Char(36)
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  endpointId     String                @db.Char(36)
  endpoint       WebhookEndpoint       @relation(fields: [organizationId, endpointId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  eventId        String                @db.Char(36)
  event          WebhookEvent          @relation(fields: [organizationId, eventId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  lastAttemptAt  DateTime?             @db.DateTime(3)
  lastStatusCode Int?
  /// Own reason, for people; never the body nor the raw error.
  reason         String?               @db.VarChar(200)
  deliveredAt    DateTime?             @db.DateTime(3)
  createdAt      DateTime              @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, endpointId, eventId])
  @@index([organizationId, endpointId, createdAt])
  @@index([organizationId, eventId])
  @@map("webhook_delivery")
}

// ── Procesos de la empresa (WMS-74, ADR 0069) ──────────────────────────

/// States of a version of a process (PROCESS_VERSION_TRANSITIONS).
enum ProcessVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum ProcessStageKind {
  MANUAL
  OPERATION
}

enum ProcessChildOrder {
  IN_ORDER
  ANY
}

enum ProcessEvidence {
  NONE
  OPTIONAL
  REQUIRED
}

enum ProcessProgressStatus {
  ACTIVE
  DONE
  CLOSED
}

/// Derived by `settleStates`; never written by hand.
enum ProcessStageStateStatus {
  WAITING
  READY
  DONE
  SKIPPED
}

enum ProcessStepAction {
  COMPLETED
  OPERATION
  SKIPPED
  BACK
  TAKEN
  RELEASED
  ASSIGNED
}

/// The process of one kind of document in a company («production.batch»).
model ProcessDefinition {
  id              String           @id @db.Char(36)
  organizationId  String           @db.Char(36)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  documentKey     String           @db.VarChar(80)
  createdByUserId String           @db.Char(36)
  createdAt       DateTime         @default(now()) @db.DateTime(3)
  versions        ProcessVersion[]

  @@unique([organizationId, id])
  @@unique([organizationId, documentKey])
  @@map("process_definition")
}

/// A version of a process. Published, it never changes (triggers).
model ProcessVersion {
  id                String               @id @db.Char(36)
  organizationId    String               @db.Char(36)
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  definitionId      String               @db.Char(36)
  definition        ProcessDefinition    @relation(fields: [organizationId, definitionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  number            Int
  status            ProcessVersionStatus @default(DRAFT)
  /// The definition while DRAFT (one draft per definition), else null.
  draftKey          String?              @db.Char(36)
  /// The definition while PUBLISHED (one in force), else null.
  currentKey        String?              @db.Char(36)
  createdByUserId   String               @db.Char(36)
  createdAt         DateTime             @default(now()) @db.DateTime(3)
  updatedAt         DateTime             @updatedAt @db.DateTime(3)
  publishedByUserId String?              @db.Char(36)
  publishedAt       DateTime?            @db.DateTime(3)
  retiredAt         DateTime?            @db.DateTime(3)
  stages            ProcessStage[]
  progress          ProcessProgress[]

  @@unique([organizationId, id])
  @@unique([organizationId, definitionId, number])
  @@unique([organizationId, draftKey])
  @@unique([organizationId, currentKey])
  @@map("process_version")
}

/// A stage or a sub-stage (`parentStageId`) of a version.
model ProcessStage {
  id               String              @id @db.Char(36)
  organizationId   String              @db.Char(36)
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  versionId        String              @db.Char(36)
  version          ProcessVersion      @relation(fields: [organizationId, versionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  parentStageId    String?             @db.Char(36)
  parent           ProcessStage?       @relation("ProcessSubStages", fields: [organizationId, parentStageId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  children         ProcessStage[]      @relation("ProcessSubStages")
  position         Int
  name             String              @db.VarChar(60)
  kind             ProcessStageKind
  /// The operation of the module that completes it (OPERATION only).
  operationKey     String?             @db.VarChar(80)
  /// The fixed state of the document it belongs to.
  milestoneKey     String              @db.VarChar(40)
  /// How its sub-stages are done (only with sub-stages).
  childOrder       ProcessChildOrder   @default(IN_ORDER)
  noteEvidence     ProcessEvidence     @default(NONE)
  photoEvidence    ProcessEvidence     @default(NONE)
  quantityEvidence ProcessEvidence     @default(NONE)
  allowSkip        Boolean             @default(false)
  allowBack        Boolean             @default(false)
  /// The area works only inside the zone of the document.
  zoneOnly         Boolean             @default(false)
  createdAt        DateTime            @default(now()) @db.DateTime(3)
  roles            ProcessStageRole[]
  states           ProcessStageState[]
  steps            ProcessStep[]

  @@unique([organizationId, id])
  @@index([organizationId, versionId, position])
  @@map("process_stage")
}

/// A role of the area of a stage.
model ProcessStageRole {
  id             String       @id @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  stageId        String       @db.Char(36)
  stage          ProcessStage @relation(fields: [organizationId, stageId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  role           String       @db.VarChar(40)

  @@unique([organizationId, id])
  @@unique([organizationId, stageId, role])
  @@map("process_stage_role")
}

/// The process of one document, fixed to its version (P11).
model ProcessProgress {
  id             String                @id @db.Char(36)
  organizationId String                @db.Char(36)
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  documentKey    String                @db.VarChar(80)
  documentId     String                @db.Char(36)
  versionId      String                @db.Char(36)
  version        ProcessVersion        @relation(fields: [organizationId, versionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Where the document is (scope and zone of its area, WMS-20).
  facilityId     String                @db.Char(36)
  facility       Facility              @relation(fields: [organizationId, facilityId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  locationId     String?               @db.Char(36)
  location       Location?             @relation(fields: [organizationId, facilityId, locationId], references: [organizationId, facilityId, id], onDelete: Restrict, onUpdate: Restrict)
  /// The fixed state the document is in.
  milestoneKey   String                @db.VarChar(40)
  /// What people read: «LP-0001».
  label          String                @db.VarChar(80)
  status         ProcessProgressStatus @default(ACTIVE)
  createdAt      DateTime              @default(now()) @db.DateTime(3)
  updatedAt      DateTime              @updatedAt @db.DateTime(3)
  finishedAt     DateTime?             @db.DateTime(3)
  states         ProcessStageState[]
  steps          ProcessStep[]

  @@unique([organizationId, id])
  @@unique([organizationId, documentKey, documentId])
  @@index([organizationId, status, facilityId])
  @@map("process_progress")
}

/// Where one stage of work of a document is, and who has it.
model ProcessStageState {
  id               String                  @id @db.Char(36)
  organizationId   String                  @db.Char(36)
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  progressId       String                  @db.Char(36)
  progress         ProcessProgress         @relation(fields: [organizationId, progressId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  stageId          String                  @db.Char(36)
  stage            ProcessStage            @relation(fields: [organizationId, stageId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Copied from the stage, to list pending work without a join.
  kind             ProcessStageKind
  status           ProcessStageStateStatus @default(WAITING)
  takenByUserId    String?                 @db.Char(36)
  takenAt          DateTime?               @db.DateTime(3)
  assignedByUserId String?                 @db.Char(36)
  readyAt          DateTime?               @db.DateTime(3)
  doneAt           DateTime?               @db.DateTime(3)
  doneByUserId     String?                 @db.Char(36)
  updatedAt        DateTime                @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, progressId, stageId])
  @@index([organizationId, status, kind, takenByUserId, readyAt, id])
  @@map("process_stage_state")
}

/// The trail of a process: never changes, never goes away (triggers).
model ProcessStep {
  id             String            @id @db.Char(36)
  organizationId String            @db.Char(36)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  progressId     String            @db.Char(36)
  progress       ProcessProgress   @relation(fields: [organizationId, progressId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  stageId        String            @db.Char(36)
  stage          ProcessStage      @relation(fields: [organizationId, stageId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  action         ProcessStepAction
  /// Null when the system did it.
  actorUserId    String?           @db.Char(36)
  /// Who received it (ASSIGNED).
  assigneeUserId String?           @db.Char(36)
  /// Who had it before (ASSIGNED, RELEASED), if somebody did.
  previousUserId String?           @db.Char(36)
  note           String?           @db.VarChar(500)
  quantity       Decimal?          @db.Decimal(18, 3)
  /// «Chrome en Android» (describeUserAgent, never the raw text).
  device         String?           @db.VarChar(120)
  idempotencyKey String?           @db.VarChar(64)
  createdAt      DateTime          @default(now()) @db.DateTime(3)
  photos         EvidencePhoto[]

  @@unique([organizationId, id])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, progressId, createdAt, id])
  @@map("process_step")
}

// ---------------------------------------------------------------------------
// Producción (WMS-27, ADR 0066)

enum RecipeVersionStatus {
  DRAFT
  ACTIVE
  RETIRED
  DISCARDED
}

/// The recipe of a product (WMS-27, ADR 0066): one per product, standard,
/// defined by who runs production. What it says lives in its versions.
/// Never deleted, and its product never changes (triggers).
model Recipe {
  id              String          @id @db.Char(36)
  organizationId  String          @db.Char(36)
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  productId       String          @db.Char(36)
  product         Product         @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  /// WMS-28 (ADR 0073): the production area its orders propose (a location
  /// of use «Producción»); optional, changes with `setRecipeArea`.
  areaLocationId  String?         @db.Char(36)
  area            Location?       @relation("RecipeArea", fields: [organizationId, areaLocationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdByUserId String          @db.Char(36)
  createdAt       DateTime        @default(now()) @db.DateTime(3)
  updatedAt       DateTime        @updatedAt @db.DateTime(3)
  versions        RecipeVersion[]

  @@unique([organizationId, id])
  @@unique([organizationId, productId])
  @@map("recipe")
}

/// One version of a recipe: for how much (in the unit of the product of the
/// card), its materials and what comes out. Draft → active → retired, or
/// draft → discarded (RECIPE_VERSION_TRANSITIONS and trigger). One active
/// and one draft per recipe at most (`activeRecipeId`/`draftRecipeId`,
/// CHECK and unique index). Only a draft changes; nothing is deleted.
model RecipeVersion {
  id                String              @id @db.Char(36)
  organizationId    String              @db.Char(36)
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  recipeId          String              @db.Char(36)
  recipe            Recipe              @relation(fields: [organizationId, recipeId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  number            Int
  status            RecipeVersionStatus @default(DRAFT)
  /// For how much of the product of the card, in `unitCode`.
  baseQuantity      Decimal             @db.Decimal(12, 3)
  unitCode          String              @db.VarChar(12)
  /// The recipe id while ACTIVE, NULL otherwise: one active per recipe.
  activeRecipeId    String?             @db.Char(36)
  /// The recipe id while DRAFT, NULL otherwise: one draft per recipe.
  draftRecipeId     String?             @db.Char(36)
  createdByUserId   String              @db.Char(36)
  activatedAt       DateTime?           @db.DateTime(3)
  activatedByUserId String?             @db.Char(36)
  retiredAt         DateTime?           @db.DateTime(3)
  retiredByUserId   String?             @db.Char(36)
  discardedAt       DateTime?           @db.DateTime(3)
  discardedByUserId String?             @db.Char(36)
  createdAt         DateTime            @default(now()) @db.DateTime(3)
  updatedAt         DateTime            @updatedAt @db.DateTime(3)
  inputs            RecipeInput[]
  outputs           RecipeOutput[]
  /// WMS-28 (ADR 0073): orders that copied this version.
  productionOrders  ProductionOrder[]

  @@unique([organizationId, id])
  @@unique([organizationId, recipeId, number])
  @@unique([organizationId, activeRecipeId])
  @@unique([organizationId, draftRecipeId])
  @@index([organizationId, status])
  @@map("recipe_version")
}

/// One material of a recipe version, as an order line keeps it: what was
/// written, the presentation and version of its content then, the factor
/// and the result in the unit of the material (`unitCode` at that moment).
/// Expected scrap is informative. One line per product; only while the
/// version is a draft (triggers).
model RecipeInput {
  id                    String               @id @db.Char(36)
  organizationId        String               @db.Char(36)
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  versionId             String               @db.Char(36)
  version               RecipeVersion        @relation(fields: [organizationId, versionId], references: [organizationId, id], onDelete: Restrict)
  lineNumber            Int
  productId             String               @db.Char(36)
  product               Product              @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  capturedQuantity      Decimal              @db.Decimal(12, 3)
  presentationId        String?              @db.Char(36)
  presentation          ProductPresentation? @relation(fields: [organizationId, productId, presentationId], references: [organizationId, productId, id], onDelete: Restrict, onUpdate: Restrict)
  presentationVersionId String?              @db.Char(36)
  presentationVersion   PresentationVersion? @relation(fields: [organizationId, presentationId, presentationVersionId], references: [organizationId, presentationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Unit of another measure it was captured in («g» for a product in kg).
  capturedUnitCode      String?              @db.VarChar(12)
  factor                Decimal              @db.Decimal(18, 6)
  baseQuantity          Decimal              @db.Decimal(12, 3)
  unitCode              String               @db.VarChar(12)
  /// Expected scrap, percent (0 to less than 100), optional.
  scrapPercent          Decimal?             @db.Decimal(5, 2)
  createdAt             DateTime             @default(now()) @db.DateTime(3)
  updatedAt             DateTime             @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, versionId, lineNumber])
  @@unique([organizationId, versionId, productId])
  @@index([organizationId, productId])
  @@map("recipe_input")
}

/// What comes out of a recipe version: a product, how much for the base
/// (in its unit) and its share of the cost (percent; the shares of a
/// version add up to 100 to activate it). One line per product; only while
/// the version is a draft (triggers).
model RecipeOutput {
  id             String        @id @db.Char(36)
  organizationId String        @db.Char(36)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  versionId      String        @db.Char(36)
  version        RecipeVersion @relation(fields: [organizationId, versionId], references: [organizationId, id], onDelete: Restrict)
  lineNumber     Int
  productId      String        @db.Char(36)
  product        Product       @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  quantity       Decimal       @db.Decimal(12, 3)
  unitCode       String        @db.VarChar(12)
  costShare      Decimal       @db.Decimal(5, 2)
  createdAt      DateTime      @default(now()) @db.DateTime(3)
  updatedAt      DateTime      @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, versionId, lineNumber])
  @@unique([organizationId, versionId, productId])
  @@index([organizationId, productId])
  @@map("recipe_output")
}

/// One row per company whose lock puts every recipe activation of the
/// company one after the other, so two at once cannot close a cycle
/// (ADR 0066). Its id is the company id. Holds nothing else.
model RecipeLock {
  id             String       @id @db.Char(36)
  organizationId String       @unique @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  @@map("recipe_lock")
}

// ---------------------------------------------------------------------------
// Calidad: inspection plans and defects (WMS-30A, ADR 0067)
// ---------------------------------------------------------------------------

/// State of a version of an inspection plan: drafted, in force, replaced by
/// a newer one or dropped before being published. Never deleted.
enum QualityPlanStatus {
  DRAFT
  ACTIVE
  RETIRED
  DISCARDED
}

/// How the quality is checked: as the company setting says, all of it, or
/// a sample (D6). The quantity is always counted in full (D5).
enum QualitySampling {
  DEFAULT
  FULL
  SAMPLE
}

/// Size of a sample: a fixed quantity, or a percentage with a minimum and
/// an optional cap.
enum QualitySampleRule {
  FIXED
  PERCENT
}

/// What a check point records: yes or no, a number in a range, one option
/// of a list, or a note.
enum QualityPointKind {
  CHECK
  NUMBER
  CHOICE
  TEXT
}

/// How serious a defect is; information for the inspector and reports.
enum QualityDefectSeverity {
  MINOR
  MAJOR
  CRITICAL
}

/// The inspection plan of a product: one per product, with its versions.
/// Never deleted; the product never changes (trigger).
model QualityPlan {
  id              String               @id @db.Char(36)
  organizationId  String               @db.Char(36)
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  productId       String               @db.Char(36)
  product         Product              @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdByUserId String               @db.Char(36)
  createdAt       DateTime             @default(now()) @db.DateTime(3)
  versions        QualityPlanVersion[]

  @@unique([organizationId, id])
  @@unique([organizationId, productId])
  @@map("quality_plan")
}

/// A version of an inspection plan. Only a draft changes; publishing
/// retires the one in force (triggers). `draftPlanId` and `activePlanId`
/// hold the plan only while the version is a draft or in force, so a plan
/// has at most one of each.
model QualityPlanVersion {
  id                String             @id @db.Char(36)
  organizationId    String             @db.Char(36)
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  planId            String             @db.Char(36)
  plan              QualityPlan        @relation(fields: [organizationId, planId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  number            Int
  status            QualityPlanStatus  @default(DRAFT)
  draftPlanId       String?            @db.Char(36)
  activePlanId      String?            @db.Char(36)
  sampling          QualitySampling    @default(DEFAULT)
  sampleRule        QualitySampleRule?
  /// FIXED: how much is checked, in the unit of the product.
  sampleQuantity    Decimal?           @db.Decimal(15, 3)
  /// PERCENT: share of what is verified (1 to 100), at least `sampleMin`
  /// and at most `sampleMax` (optional).
  samplePercent     Int?
  sampleMin         Decimal?           @db.Decimal(15, 3)
  sampleMax         Decimal?           @db.Decimal(15, 3)
  forProduced       Boolean            @default(true)
  forReceived       Boolean            @default(true)
  forReturned       Boolean            @default(true)
  createdByUserId   String             @db.Char(36)
  createdAt         DateTime           @default(now()) @db.DateTime(3)
  publishedByUserId String?            @db.Char(36)
  publishedAt       DateTime?          @db.DateTime(3)
  /// When it was retired or discarded, and by whom.
  closedByUserId    String?            @db.Char(36)
  closedAt          DateTime?          @db.DateTime(3)
  points            QualityPlanPoint[]

  @@unique([organizationId, id])
  @@unique([organizationId, planId, number])
  @@unique([organizationId, draftPlanId])
  @@unique([organizationId, activePlanId])
  @@map("quality_plan_version")
}

/// A check point of a version. Written or removed only while its version
/// is a draft (triggers).
model QualityPlanPoint {
  id             String                   @id @db.Char(36)
  organizationId String                   @db.Char(36)
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  versionId      String                   @db.Char(36)
  version        QualityPlanVersion       @relation(fields: [organizationId, versionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  position       Int
  label          String                   @db.VarChar(80)
  kind           QualityPointKind
  required       Boolean                  @default(true)
  /// The inspector attaches a photo for it (WMS-30B, with WMS-37).
  photo          Boolean                  @default(false)
  /// NUMBER: acceptable range (either end optional, at least one).
  minValue       Decimal?                 @db.Decimal(19, 4)
  maxValue       Decimal?                 @db.Decimal(19, 4)
  unitLabel      String?                  @db.VarChar(20)
  createdAt      DateTime                 @default(now()) @db.DateTime(3)
  options        QualityPlanPointOption[]

  @@unique([organizationId, id])
  @@unique([organizationId, versionId, label])
  @@index([organizationId, versionId, position])
  @@map("quality_plan_point")
}

/// An option of a «one of a list» point, and whether choosing it passes.
model QualityPlanPointOption {
  id             String           @id @db.Char(36)
  organizationId String           @db.Char(36)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  pointId        String           @db.Char(36)
  point          QualityPlanPoint @relation(fields: [organizationId, pointId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  position       Int
  label          String           @db.VarChar(60)
  acceptable     Boolean

  @@unique([organizationId, id])
  @@unique([organizationId, pointId, label])
  @@map("quality_plan_point_option")
}

/// A defect the company recognizes (WMS-30A), named freely. Renamed or
/// archived, never deleted (trigger): an inspection that named it keeps
/// naming it.
model QualityDefect {
  id              String                @id @db.Char(36)
  organizationId  String                @db.Char(36)
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Unique in the company without capitals or accents (the collation).
  name            String                @db.VarChar(60)
  severity        QualityDefectSeverity @default(MAJOR)
  archivedAt      DateTime?             @db.DateTime(3)
  createdByUserId String                @db.Char(36)
  createdAt       DateTime              @default(now()) @db.DateTime(3)
  updatedAt       DateTime              @updatedAt @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@index([organizationId, archivedAt, name])
  @@map("quality_defect")
}

/// One row per company, locked by whoever changes how many defects are in
/// use (adding or bringing one back), so the cap holds with requests at
/// once (WMS-30A). Created the first time it is needed; never deleted.
model QualityDefectCatalog {
  id             String       @id @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId])
  @@map("quality_defect_catalog")
}

/// States of a production order (WMS-28, ADR 0073): PRODUCTION_ORDER_
/// TRANSITIONS and its trigger. IN_PROGRESS arrives with the first report
/// (WMS-29) and CLOSED with the close (WMS-31).
enum ProductionOrderStatus {
  DRAFT
  RELEASED
  IN_PROGRESS
  CLOSED
  CANCELLED
}

/// A production order (WMS-28, ADR 0073), `OP-0001`: a product with its
/// recipe in force, a quantity and a production area of a warehouse. It
/// copies the version of the recipe (materials and what comes out, scaled)
/// and, released, sets its materials aside (`production_order_line`). What
/// it makes, its warehouse, author and number never change; the rest only
/// in draft (triggers). Never deleted.
model ProductionOrder {
  id                String                    @id @db.Char(36)
  organizationId    String                    @db.Char(36)
  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  number            Int
  facilityId        String                    @db.Char(36)
  facility          Facility                  @relation(fields: [organizationId, facilityId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Where it is made: a location of use «Producción» of `facilityId`.
  areaLocationId    String                    @db.Char(36)
  area              Location                  @relation("ProductionArea", fields: [organizationId, areaLocationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  productId         String                    @db.Char(36)
  product           Product                   @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// The version of the recipe it copied.
  recipeVersionId   String                    @db.Char(36)
  recipeVersion     RecipeVersion             @relation(fields: [organizationId, recipeVersionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// How much of the product, in `unitCode` (its unit when created).
  quantity          Decimal                   @db.Decimal(12, 3)
  unitCode          String                    @db.VarChar(12)
  /// Day it is committed for (calendar day of the company).
  dueOn             DateTime?                 @db.Date
  priority          WarehouseTaskPriority     @default(NORMAL)
  note              String?                   @db.VarChar(500)
  status            ProductionOrderStatus     @default(DRAFT)
  /// Who created it (or, with WMS-28B, who approved the request).
  createdByUserId   String                    @db.Char(36)
  createdAt         DateTime                  @default(now()) @db.DateTime(3)
  releasedAt        DateTime?                 @db.DateTime(3)
  releasedByUserId  String?                   @db.Char(36)
  /// First report (WMS-29).
  startedAt         DateTime?                 @db.DateTime(3)
  /// Close (WMS-31), with its reason when something was missing.
  closedAt          DateTime?                 @db.DateTime(3)
  closedByUserId    String?                   @db.Char(36)
  closeReason       String?                   @db.VarChar(300)
  cancelledAt       DateTime?                 @db.DateTime(3)
  cancelledByUserId String?                   @db.Char(36)
  cancelReason      String?                   @db.VarChar(300)
  updatedAt         DateTime                  @updatedAt @db.DateTime(3)
  lines             ProductionOrderLine[]
  outputs           ProductionOrderOutput[]
  assignees         ProductionOrderAssignee[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([organizationId, facilityId, status, number])
  @@index([organizationId, status, number])
  @@index([organizationId, productId])
  @@index([organizationId, areaLocationId])
  @@index([organizationId, recipeVersionId])
  @@map("production_order")
}

/// A material of a production order (WMS-28): the recipe line scaled to the
/// order and rounded up to the material's step, in its unit. Released, it
/// is what the order sets aside (reservations with source
/// `production_order_line`). Only while the order is a draft (triggers).
model ProductionOrderLine {
  id             String          @id @db.Char(36)
  organizationId String          @db.Char(36)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  orderId        String          @db.Char(36)
  order          ProductionOrder @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  lineNumber     Int
  productId      String          @db.Char(36)
  product        Product         @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// For the order, in `unitCode`.
  quantity       Decimal         @db.Decimal(12, 3)
  unitCode       String          @db.VarChar(12)
  /// What the recipe says for its base, and the expected scrap (informative).
  recipeQuantity Decimal         @db.Decimal(12, 3)
  scrapPercent   Decimal?        @db.Decimal(5, 2)
  createdAt      DateTime        @default(now()) @db.DateTime(3)
  /// «Surtir a producción» tasks of this line.
  tasks          WarehouseTask[]

  @@unique([organizationId, id])
  @@unique([organizationId, orderId, lineNumber])
  @@unique([organizationId, orderId, productId])
  @@index([organizationId, productId])
  @@map("production_order_line")
}

/// What a production order is expected to make (WMS-28): the recipe's
/// outputs scaled and rounded down to each product's step, with its share
/// of the cost (percent). Only while the order is a draft (triggers).
model ProductionOrderOutput {
  id             String          @id @db.Char(36)
  organizationId String          @db.Char(36)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  orderId        String          @db.Char(36)
  order          ProductionOrder @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  lineNumber     Int
  productId      String          @db.Char(36)
  product        Product         @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  quantity       Decimal         @db.Decimal(12, 3)
  unitCode       String          @db.VarChar(12)
  costShare      Decimal         @db.Decimal(5, 2)
  createdAt      DateTime        @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, orderId, lineNumber])
  @@unique([organizationId, orderId, productId])
  @@index([organizationId, productId])
  @@map("production_order_output")
}

/// A person assigned to a production order (WMS-28): who will make it. They
/// change until the order is closed or cancelled (trigger).
model ProductionOrderAssignee {
  id              String          @id @db.Char(36)
  organizationId  String          @db.Char(36)
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  orderId         String          @db.Char(36)
  order           ProductionOrder @relation(fields: [organizationId, orderId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  userId          String          @db.Char(36)
  createdByUserId String          @db.Char(36)
  createdAt       DateTime        @default(now()) @db.DateTime(3)

  @@unique([organizationId, id])
  @@unique([organizationId, orderId, userId])
  @@index([organizationId, userId])
  @@map("production_order_assignee")
}
